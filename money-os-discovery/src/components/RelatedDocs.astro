---
interface RelatedDoc {
  title: string;
  href: string;
  description?: string;
}

interface Props {
  docs: RelatedDoc[];
}

const { docs } = Astro.props;
---

{docs.length > 0 && (
  <section class="mt-16 pt-8 border-t border-neutral-800" aria-label="Related documentation">
    <h2 class="text-[11px] font-medium text-neutral-600 uppercase tracking-wider mb-4">Related</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {docs.map(doc => (
        <a
          href={doc.href}
          class="group block p-4 rounded-xl border border-neutral-800 bg-neutral-950 hover:border-neutral-700 hover:bg-neutral-900 transition-colors duration-150"
        >
          <div class="text-[13px] font-medium text-neutral-200 group-hover:text-white mb-1 flex items-center justify-between">
            {doc.title}
            <svg class="w-3.5 h-3.5 text-neutral-600 group-hover:text-neutral-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
          {doc.description && (
            <div class="text-[12px] text-neutral-500 leading-relaxed">{doc.description}</div>
          )}
        </a>
      ))}
    </div>
  </section>
)}
