---
import BrandMark from './BrandMark.astro';
---

<footer class="border-t border-neutral-900 py-10 mt-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2 text-neutral-400">
      <BrandMark size={16} />
      <span class="text-[13px] text-neutral-400">Money OS</span>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[13px] text-neutral-600">
      <a href="/docs" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">Docs</a>
      <a href="/blog" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">Blog</a>
      <a href="/comparisons" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">Compare</a>
      <a href="/use-cases" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">Use Cases</a>
      <a href="/resources" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">Resources</a>
      <a href="/changelog" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">Changelog</a>
      <a href="/rss.xml" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">RSS</a>
      <a href="https://moneyos.webasthetic.in/signup" class="hover:text-neutral-400 transition-colors focus:outline-none focus:ring-1 focus:ring-white/40 rounded">Sign up</a>
    </div>
  </div>
</footer>
