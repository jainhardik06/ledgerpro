---
/**
 * Contextual ad slot — Monetization Engine.
 *
 * Design rule (non-negotiable): ads are designed AROUND content, never the
 * reverse. This component:
 *   - Renders NOTHING unless an ad network is configured via env, so the site
 *     is clean and fast by default and during development.
 *   - Uses Carbon Ads when `PUBLIC_CARBON_SERVE` is set (tasteful, single unit),
 *     otherwise falls back to Google AdSense when `PUBLIC_ADSENSE_CLIENT` is set.
 *   - Is only ever placed on Blog and Resource pages — NEVER on docs, use cases,
 *     comparisons hero, or the homepage. Enforced by which layouts import it.
 *
 * Fill the env keys in Vercel to switch ads on. No code change required.
 */
interface Props {
  /** AdSense slot id for this specific placement (from your AdSense dashboard). */
  adSlot?: string;
  /** Visual label shown above the unit for transparency. */
  label?: string;
  /** Matches an ad_units.unitId in the Growth DB (see seed-growth-db.mjs) for analytics. */
  placement?: string;
  class?: string;
}

const { adSlot, label = 'Advertisement', placement = 'unknown', class: className = '' } = Astro.props;

const CARBON_SERVE = import.meta.env.PUBLIC_CARBON_SERVE;
const CARBON_PLACEMENT = import.meta.env.PUBLIC_CARBON_PLACEMENT;
const ADSENSE_CLIENT = import.meta.env.PUBLIC_ADSENSE_CLIENT;

const mode: 'carbon' | 'adsense' | 'none' = CARBON_SERVE
  ? 'carbon'
  : ADSENSE_CLIENT
    ? 'adsense'
    : 'none';
---

{mode !== 'none' && (
  <aside class={`my-10 ${className}`} aria-label={label}>
    <div class="text-[10px] uppercase tracking-wider text-neutral-700 mb-2">{label}</div>
    <div
      class="rounded-xl border border-neutral-900 bg-neutral-950/60 p-4 flex items-center justify-center min-h-[100px]"
      data-ad-track
      data-ad-placement={placement}
      data-ad-network={mode}
    >
      {mode === 'carbon' && (
        <script async type="text/javascript" src={`//cdn.carbonads.com/carbon.js?serve=${CARBON_SERVE}&placement=${CARBON_PLACEMENT}`} id="_carbonads_js"></script>
      )}
      {mode === 'adsense' && (
        <ins
          class="adsbygoogle block w-full"
          style="display:block"
          data-ad-client={ADSENSE_CLIENT}
          data-ad-slot={adSlot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      )}
    </div>
  </aside>
)}

{mode === 'adsense' && (
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
)}

<style is:global>
  /* Carbon Ads — match the site's dark, restrained aesthetic. */
  #carbonads {
    font-family: var(--font-sans);
    max-width: 100%;
  }
  #carbonads a { color: #ededed; text-decoration: none; }
  #carbonads .carbon-text { color: #a3a3a3; font-size: 13px; line-height: 1.5; }
  #carbonads .carbon-poweredby { color: #525252; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }
</style>
