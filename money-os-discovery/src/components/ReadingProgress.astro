<!-- CSS-only reading progress: uses scroll-driven animations (Chrome 115+) -->
<!-- Falls back gracefully in older browsers (bar just stays at 0) -->
<div
  id="reading-progress"
  class="fixed top-14 left-0 right-0 z-40 h-0.5 bg-neutral-800 pointer-events-none"
  aria-hidden="true"
>
  <div id="reading-progress-bar" class="h-full bg-white origin-left" style="width: 0%"></div>
</div>

<script>
  const bar = document.getElementById('reading-progress-bar');
  if (bar) {
    function updateProgress() {
      const doc = document.documentElement;
      const totalHeight = doc.scrollHeight - doc.clientHeight;
      const scrolled = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
      bar.style.width = `${Math.min(scrolled, 100)}%`;
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }
</script>
