---
/**
 * The Money OS brand mark — "Dynamic Ledger Gate": interlocking offset
 * chevrons representing credit (in) and debit (out). This is a byte-for-byte
 * port of the same SVG paths used by the root product
 * (src/components/ui/BrandMark.tsx / src/app/icon.svg), so the discovery
 * site and the product render an identical mark.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`shrink-0 select-none ${className}`}
  aria-hidden="true"
>
  <path
    d="M 6 11 L 16 21 L 26 11"
    stroke="currentColor"
    stroke-width="3.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M 6 21 L 16 11 L 26 21"
    stroke="currentColor"
    stroke-width="3.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    opacity="0.5"
  />
</svg>
