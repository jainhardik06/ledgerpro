---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="w-48 shrink-0 hidden xl:flex flex-col sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto py-6 pl-4 scrollbar-hide" aria-label="Table of contents">
    <div class="text-[11px] font-medium text-neutral-600 uppercase tracking-wider mb-3">On this page</div>
    <ol class="flex flex-col gap-0.5 list-none">
      {filteredHeadings.map(heading => (
        <li>
          <a
            href={`#${heading.slug}`}
            class={`block text-[13px] text-neutral-500 hover:text-neutral-200 transition-colors duration-150 leading-relaxed py-0.5 toc-link ${
              heading.depth === 3 ? 'pl-3 text-[12px]' : ''
            }`}
            data-heading={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  const tocLinks = document.querySelectorAll('.toc-link');
  const headingElements: Element[] = [];

  tocLinks.forEach(link => {
    const id = link.getAttribute('data-heading');
    if (id) {
      const el = document.getElementById(id);
      if (el) headingElements.push(el);
    }
  });

  if (headingElements.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(link => {
              link.classList.remove('text-white', 'font-medium');
              link.classList.add('text-neutral-500');
            });
            const activeLink = document.querySelector(`.toc-link[data-heading="${entry.target.id}"]`);
            if (activeLink) {
              activeLink.classList.remove('text-neutral-500');
              activeLink.classList.add('text-white', 'font-medium');
            }
          }
        });
      },
      { rootMargin: '-64px 0px -80% 0px', threshold: 0 }
    );
    headingElements.forEach(el => observer.observe(el));
  }
</script>
