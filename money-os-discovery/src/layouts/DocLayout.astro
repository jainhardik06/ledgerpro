---
import Layout from './Layout.astro';
import TopNav from '../components/TopNav.astro';
import DocSidebar from '../components/DocSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import RelatedDocs from '../components/RelatedDocs.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  section?: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  publishDate?: Date;
  updatedDate?: Date;
  relatedDocs?: Array<{ title: string; href: string; description?: string }>;
  schema?: Record<string, any>;
}

const {
  title,
  description,
  section,
  headings = [],
  publishDate,
  updatedDate,
  relatedDocs = [],
  schema,
} = Astro.props;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  about: {
    '@type': 'SoftwareApplication',
    name: 'Money OS',
    applicationCategory: 'BusinessApplication',
  },
  ...(publishDate && { datePublished: publishDate.toISOString() }),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
};

const finalSchema = schema ?? defaultSchema;
---

<Layout title={title} description={description}>
  <TopNav />
  <ReadingProgress />

  <div class="max-w-7xl mx-auto flex">
    <!-- Left Sidebar -->
    <DocSidebar />

    <!-- Main Content -->
    <main class="flex-1 min-w-0 px-6 lg:px-10 py-10 max-w-3xl">
      <Breadcrumbs current={title} section={section} />

      <!-- Article Header -->
      <header class="mb-10">
        {section && (
          <div class="text-[11px] font-medium text-neutral-600 uppercase tracking-wider mb-3">
            {section}
          </div>
        )}
        <h1 class="text-[32px] font-semibold text-neutral-100 tracking-tight leading-tight mb-4">
          {title}
        </h1>
        {description && (
          <p class="text-[16px] text-neutral-400 leading-relaxed max-w-prose">
            {description}
          </p>
        )}
        {(publishDate || updatedDate) && (
          <div class="flex items-center gap-3 mt-5 text-[12px] text-neutral-600">
            {publishDate && (
              <time datetime={publishDate.toISOString()}>
                Published {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            )}
            {updatedDate && (
              <>
                <span>·</span>
                <time datetime={updatedDate.toISOString()}>
                  Updated {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </>
            )}
          </div>
        )}
        <div class="border-t border-neutral-800 mt-8"></div>
      </header>

      <!-- Content Prose Area -->
      <article
        class="prose prose-invert prose-sm max-w-none
          prose-headings:font-semibold prose-headings:tracking-tight
          prose-h2:text-[22px] prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-neutral-100
          prose-h3:text-[17px] prose-h3:mt-7 prose-h3:mb-3 prose-h3:text-neutral-200
          prose-p:text-[14px] prose-p:text-neutral-400 prose-p:leading-[1.75] prose-p:my-4
          prose-a:text-white prose-a:underline prose-a:underline-offset-2 prose-a:decoration-neutral-700 prose-a:hover:decoration-neutral-400
          prose-strong:text-neutral-200 prose-strong:font-medium
          prose-code:text-[13px] prose-code:text-neutral-300 prose-code:bg-neutral-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
          prose-pre:bg-neutral-950 prose-pre:border prose-pre:border-neutral-800 prose-pre:rounded-xl prose-pre:overflow-x-auto
          prose-blockquote:border-l-2 prose-blockquote:border-neutral-700 prose-blockquote:pl-4 prose-blockquote:text-neutral-500 prose-blockquote:not-italic
          prose-ul:text-neutral-400 prose-ol:text-neutral-400
          prose-li:marker:text-neutral-600
          prose-hr:border-neutral-800
          prose-table:text-[13px] prose-thead:border-neutral-800 prose-tr:border-neutral-800
          prose-th:text-neutral-400 prose-th:font-medium prose-td:text-neutral-500"
      >
        <slot />
      </article>

      <!-- Related Docs -->
      <RelatedDocs docs={relatedDocs} />

      <!-- CTA Footer -->
      <div class="mt-16 p-6 rounded-xl border border-neutral-800 bg-neutral-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-[14px] font-medium text-neutral-200 mb-1">Ready to start?</div>
          <div class="text-[13px] text-neutral-500">Create your free Money OS account and see it in action.</div>
        </div>
        <a
          href="https://moneyos.webasthetic.in/signup"
          class="shrink-0 inline-flex items-center px-4 py-2 bg-white text-black text-[13px] font-medium rounded-md hover:bg-neutral-200 transition-colors duration-150"
        >
          Start free →
        </a>
      </div>
    </main>

    <!-- Right TOC Sidebar -->
    <TableOfContents headings={headings} />
  </div>

  <Footer />

  <!-- JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
</Layout>

{/* Callouts, code block overrides, reading-progress transition, and
    scrollbar-hide now live in src/styles/global.css so they apply on
    every page, not just pages that render this specific layout. */}
