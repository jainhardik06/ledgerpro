---
import Layout from './Layout.astro';
import TopNav from '../components/TopNav.astro';
import AdSlot from '../components/AdSlot.astro';

interface FeatureRow {
  feature: string;
  moneyOsHas: boolean;
  competitorHas: boolean;
  notes?: string;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  competitorName: string;
  winner?: 'money-os' | 'competitor' | 'tie';
  featureMatrix?: FeatureRow[];
  publishDate: Date;
  updatedDate?: Date;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  slug,
  competitorName,
  winner = 'money-os',
  featureMatrix = [],
  publishDate,
  updatedDate,
  faq = [],
} = Astro.props;

const siteUrl = 'https://discover.moneyos.webasthetic.in';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const Check = '✓';
const Cross = '—';

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
} : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: `${siteUrl}/og/comparisons/${slug}.png`,
  datePublished: publishDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: 'Money OS' },
};
---

<Layout title={title} description={description} ogImage={`/og/comparisons/${slug}.png`} type="article">
  <TopNav />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <nav class="flex items-center gap-1.5 text-[13px] text-neutral-500 mb-8">
      <a href="/" class="hover:text-neutral-300 transition-colors">Home</a>
      <span class="text-neutral-700">/</span>
      <a href="/comparisons" class="hover:text-neutral-300 transition-colors">Comparisons</a>
      <span class="text-neutral-700">/</span>
      <span class="text-neutral-300 font-medium truncate">Money OS vs {competitorName}</span>
    </nav>

    <header class="mb-10">
      <div class="text-[11px] font-medium text-neutral-600 uppercase tracking-wider mb-3">Comparison</div>
      <h1 class="text-[32px] sm:text-[40px] font-semibold text-neutral-100 tracking-tight leading-[1.12] mb-5">{title}</h1>
      <p class="text-[16px] text-neutral-400 leading-relaxed mb-5">{description}</p>
      <div class="text-[12px] text-neutral-600">
        Updated {fmt(updatedDate ?? publishDate)}
      </div>
    </header>

    {featureMatrix.length > 0 && (
      <div class="mb-12 overflow-x-auto rounded-xl border border-neutral-800">
        <table class="w-full text-[13px]">
          <thead>
            <tr class="border-b border-neutral-800 bg-neutral-950">
              <th class="text-left font-medium text-neutral-400 px-4 py-3">Feature</th>
              <th class="text-center font-medium text-neutral-200 px-4 py-3">Money OS</th>
              <th class="text-center font-medium text-neutral-400 px-4 py-3">{competitorName}</th>
            </tr>
          </thead>
          <tbody>
            {featureMatrix.map((row) => (
              <tr class="border-b border-neutral-900 last:border-0">
                <td class="px-4 py-3 text-neutral-300">
                  {row.feature}
                  {row.notes && <span class="block text-[11px] text-neutral-600 mt-0.5">{row.notes}</span>}
                </td>
                <td class={`px-4 py-3 text-center ${row.moneyOsHas ? 'text-emerald-400' : 'text-neutral-700'}`}>{row.moneyOsHas ? Check : Cross}</td>
                <td class={`px-4 py-3 text-center ${row.competitorHas ? 'text-neutral-300' : 'text-neutral-700'}`}>{row.competitorHas ? Check : Cross}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <article
      class="prose prose-invert prose-sm max-w-none
        prose-headings:font-semibold prose-headings:tracking-tight
        prose-h2:text-[22px] prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-neutral-100
        prose-h3:text-[17px] prose-h3:mt-7 prose-h3:mb-3 prose-h3:text-neutral-200
        prose-p:text-[15px] prose-p:text-neutral-300 prose-p:leading-[1.8] prose-p:my-5
        prose-a:text-white prose-a:underline prose-a:underline-offset-2 prose-a:decoration-neutral-600 prose-a:hover:decoration-neutral-300
        prose-strong:text-neutral-100 prose-strong:font-semibold
        prose-ul:text-neutral-300 prose-li:my-1.5 prose-li:marker:text-neutral-600
        prose-table:text-[14px] prose-th:text-neutral-300 prose-td:text-neutral-400"
    >
      <slot />
    </article>

    <AdSlot adSlot={import.meta.env.PUBLIC_ADSENSE_SLOT_BLOG} />

    <div class="mt-12 p-6 rounded-xl border border-neutral-800 bg-neutral-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <div class="text-[15px] font-medium text-neutral-100 mb-1">Try Money OS free</div>
        <div class="text-[13px] text-neutral-500">No credit card. Free forever on the core plan.</div>
      </div>
      <a href="https://moneyos.webasthetic.in/register" class="shrink-0 inline-flex items-center px-4 py-2 bg-white text-black text-[13px] font-medium rounded-md hover:bg-neutral-200 transition-colors">
        Start free →
      </a>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Layout>
