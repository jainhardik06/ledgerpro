---
import Layout from './Layout.astro';
import TopNav from '../components/TopNav.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AdSlot from '../components/AdSlot.astro';
import InContentAd from '../components/InContentAd.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorCard from '../components/AuthorCard.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  category?: string;
  author?: string;
  publishDate: Date;
  updatedDate?: Date;
  readingTime?: number;
  coverImage?: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  faq?: Array<{ question: string; answer: string }>;
  hasAffiliate?: boolean;
  relatedPosts?: Array<{ title: string; href: string; category?: string; readingTime?: number }>;
}

const {
  title,
  description,
  slug,
  category,
  author = 'Money OS Team',
  publishDate,
  updatedDate,
  readingTime,
  coverImage,
  headings = [],
  faq = [],
  hasAffiliate = false,
  relatedPosts = [],
} = Astro.props;

const categoryLabels: Record<string, string> = {
  'expense-tracking': 'Expense Tracking',
  budgeting: 'Budgeting',
  'freelance-finance': 'Freelance Finance',
  'agency-finance': 'Agency Finance',
  'startup-finance': 'Startup Finance',
  'tax-tips': 'Tax Tips',
  'product-updates': 'Product Updates',
  'tools-and-resources': 'Tools & Resources',
};

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const siteUrl = 'https://discover.moneyos.webasthetic.in';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: `${siteUrl}/og/blog/${slug}.png`,
  datePublished: publishDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Money OS',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/og/default.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}/blog/${slug}` },
};

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : undefined;
---

<Layout title={title} description={description} ogImage={`/og/blog/${slug}.png`} type="article">
  <TopNav />
  <ReadingProgress />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex gap-10">
    <!-- Article -->
    <main class="flex-1 min-w-0 max-w-2xl mx-auto py-12">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-[13px] text-neutral-500 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-neutral-300 transition-colors">Home</a>
        <span class="text-neutral-700">/</span>
        <a href="/blog" class="hover:text-neutral-300 transition-colors">Blog</a>
        <span class="text-neutral-700">/</span>
        <span class="text-neutral-300 font-medium truncate">{title}</span>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        {category && (
          <div class="text-[11px] font-medium text-neutral-500 uppercase tracking-wider mb-4">
            {categoryLabels[category] ?? category}
          </div>
        )}
        <h1 class="text-[32px] sm:text-[40px] font-semibold text-neutral-100 tracking-tight leading-[1.12] mb-5">
          {title}
        </h1>
        <p class="text-[16px] text-neutral-400 leading-relaxed mb-6">{description}</p>
        <div class="flex items-center gap-3 text-[12px] text-neutral-600">
          <span>{author}</span>
          <span>·</span>
          <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>
          {readingTime && (<><span>·</span><span>{readingTime} min read</span></>)}
        </div>
        {updatedDate && (
          <div class="text-[12px] text-neutral-600 mt-1">Updated {fmt(updatedDate)}</div>
        )}
        <div class="border-t border-neutral-800 mt-8"></div>
      </header>

      {coverImage && (
        <img src={coverImage} alt={title} class="w-full rounded-xl border border-neutral-800 mb-10" loading="eager" />
      )}

      {hasAffiliate && <AffiliateDisclosure />}

      <!-- Content -->
      <article
        class="prose prose-invert prose-sm max-w-none
          prose-headings:font-semibold prose-headings:tracking-tight prose-headings:scroll-mt-20
          prose-h2:text-[24px] prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-neutral-100
          prose-h3:text-[18px] prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-neutral-200
          prose-p:text-[15px] prose-p:text-neutral-300 prose-p:leading-[1.8] prose-p:my-5
          prose-a:text-white prose-a:underline prose-a:underline-offset-2 prose-a:decoration-neutral-600 prose-a:hover:decoration-neutral-300
          prose-strong:text-neutral-100 prose-strong:font-semibold
          prose-code:text-[13px] prose-code:text-neutral-300 prose-code:bg-neutral-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
          prose-pre:bg-neutral-950 prose-pre:border prose-pre:border-neutral-800 prose-pre:rounded-xl
          prose-blockquote:border-l-2 prose-blockquote:border-neutral-700 prose-blockquote:pl-4 prose-blockquote:text-neutral-400 prose-blockquote:not-italic prose-blockquote:font-normal
          prose-ul:text-neutral-300 prose-ol:text-neutral-300 prose-li:my-1.5 prose-li:marker:text-neutral-600
          prose-hr:border-neutral-800
          prose-table:text-[14px] prose-thead:border-neutral-700 prose-tr:border-neutral-800
          prose-th:text-neutral-300 prose-th:font-medium prose-td:text-neutral-400
          prose-img:rounded-xl prose-img:border prose-img:border-neutral-800"
      >
        <slot />
      </article>

      <!-- In-content ad: injected after the 3rd paragraph, never mid-sentence.
           Renders nothing unless AdSense is configured. -->
      <InContentAd adSlot={import.meta.env.PUBLIC_ADSENSE_SLOT_BLOG} />

      <!-- CTA -->
      <div class="mt-12 p-6 rounded-xl border border-neutral-800 bg-neutral-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="text-[15px] font-medium text-neutral-100 mb-1">Track your finances with Money OS</div>
          <div class="text-[13px] text-neutral-500">Free expense tracking, budgets, and reports. No credit card.</div>
        </div>
        <a href="https://moneyos.webasthetic.in/signup" class="shrink-0 inline-flex items-center px-4 py-2 bg-white text-black text-[13px] font-medium rounded-md hover:bg-neutral-200 transition-colors">
          Start free →
        </a>
      </div>

      <AuthorCard author={author} />
      <RelatedPosts posts={relatedPosts} />
    </main>

    <!-- Sidebar: TOC + ad -->
    <aside class="hidden xl:block w-56 shrink-0 py-12">
      <div class="sticky top-20">
        <TableOfContents headings={headings} />
        <div class="mt-6">
          <AdSlot adSlot={import.meta.env.PUBLIC_ADSENSE_SLOT_SIDEBAR} label="Sponsored" />
        </div>
      </div>
    </aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Layout>
