---
import Layout from '../../layouts/Layout.astro';
import TopNav from '../../components/TopNav.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('changelog', ({ data }) => data.status === 'published'))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate);

const rendered = await Promise.all(
  entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content })),
);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Changelog — Money OS"
  description="What's new in Money OS. Every release, feature, and fix — in plain language."
>
  <TopNav />

  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-14">
      <div class="text-[11px] font-medium text-neutral-600 uppercase tracking-wider mb-3">Changelog</div>
      <h1 class="text-[40px] sm:text-[48px] font-semibold text-neutral-100 tracking-tight leading-tight mb-4">
        What's new.
      </h1>
      <p class="text-[16px] text-neutral-400 leading-relaxed">
        Every release, in plain language. Features and fixes as they ship.
      </p>
    </div>

    {rendered.length === 0 ? (
      <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-10 text-center">
        <p class="text-[14px] text-neutral-400">Release notes are publishing soon.</p>
      </div>
    ) : (
      <div class="flex flex-col gap-14">
        {rendered.map(({ entry, Content }) => (
          <article class="relative pl-6 border-l border-neutral-800">
            <div class="absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-neutral-600"></div>
            <div class="flex items-center gap-3 mb-2">
              <time class="text-[12px] text-neutral-600">{fmt(entry.data.publishDate)}</time>
              {entry.data.version && (
                <span class="text-[11px] font-medium text-neutral-400 border border-neutral-800 rounded px-1.5 py-0.5">v{entry.data.version}</span>
              )}
            </div>
            <h2 class="text-[20px] font-semibold text-neutral-100 tracking-tight mb-3">{entry.data.title}</h2>

            <div class="prose prose-invert prose-sm max-w-none prose-p:text-[14px] prose-p:text-neutral-400 prose-p:leading-[1.75] prose-strong:text-neutral-200">
              <Content />
            </div>

            {entry.data.features && entry.data.features.length > 0 && (
              <div class="mt-4">
                <div class="text-[11px] font-medium text-emerald-400 uppercase tracking-wider mb-2">New</div>
                <ul class="flex flex-col gap-1.5">
                  {entry.data.features.map((f) => (
                    <li class="text-[13px] text-neutral-400 flex items-start gap-2">
                      <span class="text-emerald-500 mt-1.5 w-1 h-1 rounded-full bg-emerald-500 shrink-0"></span>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {entry.data.fixes && entry.data.fixes.length > 0 && (
              <div class="mt-4">
                <div class="text-[11px] font-medium text-neutral-500 uppercase tracking-wider mb-2">Fixed</div>
                <ul class="flex flex-col gap-1.5">
                  {entry.data.fixes.map((f) => (
                    <li class="text-[13px] text-neutral-500 flex items-start gap-2">
                      <span class="text-neutral-700 mt-1.5 w-1 h-1 rounded-full bg-neutral-700 shrink-0"></span>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>
