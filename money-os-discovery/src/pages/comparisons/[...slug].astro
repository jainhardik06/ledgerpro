---
import { getCollection, render } from 'astro:content';
import ComparisonLayout from '../../layouts/ComparisonLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('comparisons', ({ data }) => data.status === 'published');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ComparisonLayout
  title={item.data.title}
  description={item.data.description}
  slug={item.id}
  competitorName={item.data.competitorName}
  winner={item.data.winner}
  featureMatrix={item.data.featureMatrix}
  publishDate={item.data.publishDate}
  updatedDate={item.data.updatedDate}
  faq={item.data.faq}
>
  <Content />
</ComparisonLayout>
