---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => data.status === 'published'))
    .sort((a, b) => +b.data.publishDate - +a.data.publishDate);
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}
const { page } = Astro.props;

// Distinct categories present in the published set (for the filter row).
const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');
const categories = [...new Set(allPosts.map((p) => p.data.category).filter(Boolean))] as string[];

const categoryLabels: Record<string, string> = {
  'expense-tracking': 'Expense Tracking',
  budgeting: 'Budgeting',
  'freelance-finance': 'Freelance Finance',
  'agency-finance': 'Agency Finance',
  'startup-finance': 'Startup Finance',
  'tax-tips': 'Tax Tips',
  'product-updates': 'Product Updates',
  'tools-and-resources': 'Tools & Resources',
};

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const isFirst = page.currentPage === 1;
const [featured, ...rest] = isFirst ? page.data : [null, ...page.data];
---

<Layout
  title="Blog — Money OS"
  description="Practical finance guides for freelancers, agencies, startups, and small teams. Expense tracking, budgeting, taxes, and the tools that actually help."
>
  <TopNav />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <!-- Header -->
    <div class="mb-12">
      <div class="text-[11px] font-medium text-neutral-600 uppercase tracking-wider mb-3">Blog</div>
      <h1 class="text-[40px] sm:text-[48px] font-semibold text-neutral-100 tracking-tight leading-tight mb-4">
        Finance, without the fluff.
      </h1>
      <p class="text-[16px] text-neutral-400 leading-relaxed max-w-xl">
        Specific, honest guides for people who run their own money — freelancers, agencies, founders, and small teams.
        No AI filler. No padding.
      </p>
    </div>

    <!-- Category filter -->
    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-12">
        <a href="/blog" class="px-3 py-1.5 rounded-full text-[12px] font-medium border border-neutral-700 text-white">All</a>
        {categories.map((c) => (
          <a
            href={`/blog/category/${c}`}
            class="px-3 py-1.5 rounded-full text-[12px] font-medium border border-neutral-800 text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors"
          >
            {categoryLabels[c] ?? c}
          </a>
        ))}
      </div>
    )}

    {allPosts.length === 0 && (
      <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-10 text-center">
        <p class="text-[14px] text-neutral-400">The first articles are publishing soon.</p>
        <p class="text-[13px] text-neutral-600 mt-2">The content engine ships a new guide every few days.</p>
      </div>
    )}

    <!-- Featured (first page only) -->
    {featured && (
      <a
        href={`/blog/${featured.id}`}
        class="group block mb-10 p-8 rounded-2xl border border-neutral-800 bg-neutral-950 hover:border-neutral-700 hover:bg-neutral-900 transition-colors"
      >
        <div class="text-[11px] font-medium text-neutral-500 uppercase tracking-wider mb-3">
          {featured.data.category ? (categoryLabels[featured.data.category] ?? featured.data.category) : 'Featured'}
        </div>
        <h2 class="text-[26px] sm:text-[30px] font-semibold text-neutral-100 group-hover:text-white tracking-tight leading-snug mb-3 max-w-2xl">
          {featured.data.title}
        </h2>
        <p class="text-[14px] text-neutral-400 leading-relaxed max-w-2xl mb-4">{featured.data.description}</p>
        <div class="text-[12px] text-neutral-600">{fmt(featured.data.publishDate)}</div>
      </a>
    )}

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {rest.filter(Boolean).map((post) => (
        <a
          href={`/blog/${post!.id}`}
          class="group flex flex-col p-6 rounded-xl border border-neutral-800 bg-neutral-950 hover:border-neutral-700 hover:bg-neutral-900 transition-colors"
        >
          {post!.data.category && (
            <div class="text-[11px] font-medium text-neutral-600 mb-3">{categoryLabels[post!.data.category] ?? post!.data.category}</div>
          )}
          <h3 class="text-[15px] font-semibold text-neutral-200 group-hover:text-white leading-snug mb-2 flex-1">{post!.data.title}</h3>
          <p class="text-[13px] text-neutral-500 leading-relaxed line-clamp-2 mb-4">{post!.data.description}</p>
          <div class="text-[11px] text-neutral-600">{fmt(post!.data.publishDate)}</div>
        </a>
      ))}
    </div>

    <!-- Pagination -->
    {page.lastPage > 1 && (
      <nav class="flex items-center justify-between mt-12 pt-8 border-t border-neutral-900" aria-label="Pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="text-[13px] text-neutral-400 hover:text-white transition-colors">← Newer</a>
        ) : <span></span>}
        <span class="text-[12px] text-neutral-600">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="text-[13px] text-neutral-400 hover:text-white transition-colors">Older →</a>
        ) : <span></span>}
      </nav>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
