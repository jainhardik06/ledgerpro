# Money OS Discovery — required environment variables.
# Copy to `.env.local` and fill in. None of these are exposed to the browser.

# Growth database connection string (MongoDB Atlas, isolated cluster).
MONGODB_GROWTH_URI=

# Content engine LLM keys (scripts + CI only). Comma-separate multiple keys
# to enable automatic rotation when one hits a free-tier rate limit — see
# scripts/lib/llm.mjs. A single key in either list is also fine.
# Groq: free key at https://console.groq.com/keys
GROQ_API_KEYS=
# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEYS=

# Content engine models.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash

# Canonical public URL.
PUBLIC_SITE_URL=https://discover.moneyos.webasthetic.in

# ── Monetization (OPTIONAL — ads stay off until these are set) ──
# Carbon Ads (preferred, tasteful). From your Carbon dashboard.
PUBLIC_CARBON_SERVE=
PUBLIC_CARBON_PLACEMENT=
# Google AdSense fallback. Used only if Carbon is not configured.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_BLOG=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ── Analytics (OPTIONAL — no analytics script loads until this is set) ──
# Same PostHog project as the root Money OS product: use the same value as
# NEXT_PUBLIC_POSTHOG_KEY there, so pageviews and ad_impression/ad_click
# events land in one place.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
