# Money OS Discovery — production environment template.
#
# No real secrets live here. Astro/Vercel does not read this file for
# deployments — set real values in Vercel: Project → Settings → Environment
# Variables → Production. This file exists so the required var list is
# version-controlled and reviewable without ever committing a secret.

# ── Growth database (required) ──
# Same isolated Growth DB used by the root money-os app's Discovery Intelligence
# Center. Powers /go affiliate-redirect click logging and the content engine.
MONGODB_GROWTH_URI=

# ── Content Engine (required for automated blog publishing) ──
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Site URL ──
PUBLIC_SITE_URL=https://discover.moneyos.webasthetic.in

# ── Monetization (optional — ads stay off until these are set) ──
PUBLIC_CARBON_SERVE=
PUBLIC_CARBON_PLACEMENT=
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_BLOG=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
