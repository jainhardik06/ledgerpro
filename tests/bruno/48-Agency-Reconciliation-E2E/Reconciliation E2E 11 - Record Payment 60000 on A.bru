meta {
  name: Reconciliation E2E 11 - Record Payment 60000 on A
  type: http
  seq: 11
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{recInvAId}}",
    "amount": 60000,
    "method": "BANK_TRANSFER",
    "accountId": "{{recAccountId}}",
    "reference": "REC-NEFT-1"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('recPay1Id', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
}

docs {
  First payment: 60000 of 100000 on invoice A.
}
