meta {
  name: Reconciliation E2E 2 - Switch to Agency Mode
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/settings
  body: json
  auth: none
}

body:json {
  {
    "appMode": "Agency"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  The vertical gate for everything that follows.
}
