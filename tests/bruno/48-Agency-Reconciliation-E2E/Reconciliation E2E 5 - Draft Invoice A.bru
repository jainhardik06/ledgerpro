meta {
  name: Reconciliation E2E 5 - Draft Invoice A
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{recClientId}}",
    "issueDate": "{{recIssueDate}}",
    "notes": "Reconciliation journey — invoice A"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
  res.body.invoice.total.amount: eq 0
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('recInvAId', raw.invoice.id);
  if (raw.invoice.invoiceNumber != null) throw new Error('§74: draft must not carry a number');
}

docs {
  The first of two invoices: 100000, to be fully paid.
}
