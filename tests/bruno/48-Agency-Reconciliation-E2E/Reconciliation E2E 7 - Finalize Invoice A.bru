meta {
  name: Reconciliation E2E 7 - Finalize Invoice A
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{recInvAId}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000001
  res.body.invoice.amountDue.amount: eq 100000
}

docs {
  First finalized invoice of a fresh tenant: INV-000001, 100000 due.
}
