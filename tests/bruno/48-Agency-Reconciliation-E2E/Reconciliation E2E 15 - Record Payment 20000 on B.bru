meta {
  name: Reconciliation E2E 15 - Record Payment 20000 on B
  type: http
  seq: 15
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{recInvBId}}",
    "amount": 20000,
    "method": "UPI",
    "accountId": "{{recAccountId}}",
    "reference": "REC-UPI-1"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('recPay3Id', raw.payment.id);
}

docs {
  The partial payment on invoice B — leaves 30000 open, the receivable every
  view below must show.
}
