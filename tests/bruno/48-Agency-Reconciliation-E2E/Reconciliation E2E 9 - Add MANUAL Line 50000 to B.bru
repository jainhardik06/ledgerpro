meta {
  name: Reconciliation E2E 9 - Add MANUAL Line 50000 to B
  type: http
  seq: 9
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{recInvBId}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "MANUAL",
    "description": "Advisory retainer — reconciliation B",
    "amount": 50000
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.total.amount: eq 50000
}

docs {
  Invoice B totals 50000.
}
