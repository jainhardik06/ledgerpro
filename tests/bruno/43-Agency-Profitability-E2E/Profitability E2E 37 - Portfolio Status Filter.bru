meta {
  name: Profitability E2E 37 - Portfolio Status Filter
  type: http
  seq: 37
}

get {
  url: {{BASE_URL}}/api/agency/profitability?status=DRAFT
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  if (raw.portfolio.projects.length !== 2) throw new Error('both projects are DRAFT: ' + raw.portfolio.projects.length);
}
