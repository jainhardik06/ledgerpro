meta {
  name: Profitability E2E 1 - Signup
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "tenantName": "E2E Profitability Agency",
    "username": "{{profAdminUsername}}",
    "password": "{{profAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar('profAdminUsername', 'e2e_prof_admin_' + suffix);
  bru.setVar('profAdminPassword', 'E2eProfAdmin#2026');
}

docs {
  Fresh agency for the Module 13 profitability journey (§58–§84): the five
  dimensions end to end — time + expenses become COST, approved billable
  time becomes REVENUE, an invoice becomes BILLED, a payment becomes
  COLLECTED, and none of them ever collapse into each other (§60/§66).
}
