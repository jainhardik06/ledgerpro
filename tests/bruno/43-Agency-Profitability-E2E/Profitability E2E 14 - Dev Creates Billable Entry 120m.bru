meta {
  name: Profitability E2E 14 - Dev Creates Billable Entry 120m
  type: http
  seq: 14
}

post {
  url: {{BASE_URL}}/api/agency/time
  body: json
  auth: none
}

body:json {
  {
    "projectId": "{{projectId}}",
    "date": "{{entryDate}}",
    "durationMinutes": 120,
    "billable": true,
    "notes": "Portal API scaffolding"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.timeEntry.approvalStatus: eq DRAFT
  res.body.timeEntry.billingStatus: eq UNBILLED
  res.body.timeEntry.costRateSnapshot.amount: eq 900
  res.body.timeEntry.billingRateSnapshot.amount: eq 2500
}

script:pre-request {
  const ist = new Date(Date.now() + 5.5 * 60 * 60 * 1000);
  bru.setVar('entryDate', ist.toISOString().slice(0, 10));
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('entry1Id', raw.timeEntry.id);
  if (!raw.timeEntry.id) throw new Error('Create must return the entry id');
  if (raw.timeEntry.calculatedCost !== undefined) throw new Error('No cost may be calculated before approval');
}

docs {
  Entry 1 — the REVENUE hour-pair: 2h × 2500 = 5000 billable value,
  2h × 900 = 1800 internal cost (§23). Rates frozen at creation (§6).
}
