meta {
  name: Profitability E2E 9 - Create Dev User
  type: http
  seq: 9
}

post {
  url: {{BASE_URL}}/api/tenant/users
  body: json
  auth: none
}

body:json {
  {
    "username": "{{profDevUsername}}",
    "password": "E2eProfDev#2026"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.user.role: eq USER
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar('profDevUsername', 'e2e_prof_dev_' + suffix);
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('devUserId', raw.user.id);
  if (!raw.user.id) throw new Error('Create must return the user id');
}

docs {
  The delivery author. §21 forbids approving your own time, so the admin
  stays the approver — the profitability numbers below are all APPROVED
  economics (§63), never draft intent.
}
