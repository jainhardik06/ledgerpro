meta {
  name: Profitability E2E 32 - Confirm Payment Margin Unmoved
  type: http
  seq: 32
}

post {
  url: {{BASE_URL}}/api/agency/payments/{{paymentId}}/confirm
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.payment.status: eq CONFIRMED
  res.body.invoice.status: eq PARTIALLY_PAID
  res.body.invoice.amountPaid.amount: eq 3000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  if (!raw.transactionId) throw new Error('§129: confirm must return the core transaction id');
  // §66 — the separation is asserted one step later, through the
  // profitability snapshot: 3000 of cash must move NOTHING in the margin.
}
