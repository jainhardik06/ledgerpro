meta {
  name: Profitability E2E 18 - Dev Creates Billable Expense 1000 10pct
  type: http
  seq: 18
}

post {
  url: {{BASE_URL}}/api/agency/expenses
  body: json
  auth: none
}

body:json {
  {
    "projectId": "{{projectId}}",
    "vendorName": "StockAI",
    "description": "API credits for the portal build",
    "amount": 1000,
    "expenseType": "BILLABLE",
    "billable": true,
    "markupPercent": 10,
    "expenseDate": "{{entryDate}}"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.expense.status: eq DRAFT
  res.body.expense.billingStatus: eq UNBILLED
  res.body.expense.clientChargeAmount.amount: eq 1100
  res.body.expense.clientChargeAmount.currency: eq INR
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const e = raw.expense;
  bru.setVar('expenseId', e.id);
  if (!e.id) throw new Error('Create must return the expense id');
  if (e.clientChargeAmount.amount !== 1100) throw new Error('markup: expected 1100, got ' + e.clientChargeAmount.amount);
  // §99 — the dev is a USER: the cost side stays redacted.
  if (e.amount !== undefined) throw new Error('§99 redaction violated: amount leaked to a USER');
}

docs {
  The spend side of §63: 1000 INR cost (what the agency paid StockAI), 1100
  client charge (§43 — frozen at creation). Cost and charge are different
  numbers on purpose; profitability carries the COST.
}
