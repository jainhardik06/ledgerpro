meta {
  name: Profitability E2E 23 - Admin Approves Expense
  type: http
  seq: 23
}

post {
  url: {{BASE_URL}}/api/agency/expenses/{{expenseId}}/approve
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.expense.status: eq APPROVED
  res.body.expense.billingStatus: eq UNBILLED
  res.body.expense.amount.amount: eq 1000
  res.body.expense.clientChargeAmount.amount: eq 1100
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  if (!raw.expense.transactionId) throw new Error('APPROVED expense must carry a transactionId (§41)');
}
