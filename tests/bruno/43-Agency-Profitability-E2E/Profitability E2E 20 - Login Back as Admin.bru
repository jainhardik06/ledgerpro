meta {
  name: Profitability E2E 20 - Login Back as Admin
  type: http
  seq: 20
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{profAdminUsername}}",
    "password": "{{profAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
