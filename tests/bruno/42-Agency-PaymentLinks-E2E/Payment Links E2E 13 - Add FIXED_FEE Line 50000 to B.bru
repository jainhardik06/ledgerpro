meta {
  name: Payment Links E2E 13 - Add FIXED_FEE Line 50000 to B
  type: http
  seq: 13
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{plInvBId}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "FIXED_FEE",
    "description": "Setup fee",
    "quantity": 1,
    "unitPrice": 50000,
    "amount": 0
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.total.amount: eq 50000
}
