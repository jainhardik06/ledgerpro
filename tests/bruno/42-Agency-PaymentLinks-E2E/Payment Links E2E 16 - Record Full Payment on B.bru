meta {
  name: Payment Links E2E 16 - Record Full Payment on B
  type: http
  seq: 16
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{plInvBId}}",
    "amount": 50000,
    "method": "BANK_TRANSFER",
    "accountId": "{{plAccountId}}",
    "reference": "NEFT-PL-1"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('plPayBId', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
}
