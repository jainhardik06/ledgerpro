meta {
  name: Payment Links E2E 14 - Finalize Invoice B INV-000002
  type: http
  seq: 14
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{plInvBId}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000002
}
