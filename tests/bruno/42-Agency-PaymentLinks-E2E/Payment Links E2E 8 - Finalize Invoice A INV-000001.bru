meta {
  name: Payment Links E2E 8 - Finalize Invoice A INV-000001
  type: http
  seq: 8
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{plInvAId}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000001
  res.body.invoice.amountDue.amount: eq 100000
}
