meta {
  name: Payment Links E2E 12 - Create Invoice B Draft
  type: http
  seq: 12
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{plClientId}}",
    "issueDate": "{{plIssueDate}}",
    "notes": "Paid-off invoice — links must refuse it"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('plInvBId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}
