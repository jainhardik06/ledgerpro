meta {
  name: Payment Links E2E 5 - Create Invoice A Draft
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{plClientId}}",
    "issueDate": "{{plIssueDate}}",
    "notes": "September retainer — the Module 12 link invoice"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:pre-request {
  const ist = new Date(Date.now() + 5.5 * 60 * 60 * 1000);
  bru.setVar('plIssueDate', ist.toISOString().slice(0, 10));
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('plInvAId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}
