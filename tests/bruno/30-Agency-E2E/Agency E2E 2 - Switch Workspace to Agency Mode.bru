meta {
  name: Agency E2E 2 - Switch Workspace to Agency Mode
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/settings
  body: json
  auth: none
}

body:json {
  {
    "appMode": "Agency"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  The signup session cookie (TENANT_ADMIN) switches the workspace to the
  Agency vertical — the same path a real tenant takes in Settings.
}
