meta {
  name: Time E2E 13 - Login as Dev
  type: http
  seq: 13
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{timeDevUsername}}",
    "password": "E2eTimeDev#2026"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  The cookie jar now carries the DEV session — the time author leg begins.
