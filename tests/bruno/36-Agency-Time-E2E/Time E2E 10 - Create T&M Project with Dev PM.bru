meta {
  name: Time E2E 10 - Create T&M Project with Dev PM
  type: http
  seq: 10
}

post {
  url: {{BASE_URL}}/api/agency/projects
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "name": "Acme Portal Build",
    "code": "E2E-TIME-PORTAL",
    "billingModel": "TIME_AND_MATERIALS",
    "currency": "INR",
    "revenueBudget": 5000,
    "budgetCost": 1800,
    "targetMargin": 64,
    "plannedHours": 2,
    "projectManagerId": "{{devUserId}}"
  }
}

assert {
  res.status: eq 201
  res.body.project.billingModel: eq TIME_AND_MATERIALS
  res.body.project.projectManagerId: eq {{devUserId}}
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('projectId', raw.project.id);
  if (!raw.project.id) throw new Error('Create must return the project id');
}

docs {
  Planned economics mirror the §23 arithmetic the E2E will prove as ACTUAL:
  2 hours at 2500 billed = 5000 revenue, 2 hours at 900 cost = 1800.
  The dev is the project MANAGER (so the PM approval tier exists) AND the
  entry author — the admin approves their work.
}
