meta {
  name: Alerts E2E 62 - Summary After Collections
  type: http
  seq: 62
}

get {
  url: {{BASE_URL}}/api/agency/alerts/summary
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.counts.open: eq 7
  res.body.counts.acknowledged: eq 0
  res.body.counts.resolved: eq 2
}
