meta {
  name: Alerts E2E 56 - Resolve Acknowledged Alert
  type: http
  seq: 56
}

post {
  url: {{BASE_URL}}/api/agency/alerts/{{dueSoonAlertId}}/resolve
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.alert.status: eq RESOLVED
  res.body.alert.resolvedBy: eq {{alAdminUsername}}
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  if (!raw.alert.resolvedAt) throw new Error('Resolve must stamp resolvedAt');
}
