meta {
  name: Alerts E2E 12 - Add Project Member Developer
  type: http
  seq: 12
}

post {
  url: {{BASE_URL}}/api/agency/projects/{{projectId}}/members
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{devUserId}}",
    "role": "Developer",
    "allocationPercent": 100
  }
}

assert {
  res.status: eq 201
  res.body.member.role: eq Developer
}

docs {
  §89 — the project role "Developer" is what the client billing card
  matches; the cost side resolves through the next step's assignment.
}
