meta {
  name: Alerts E2E 78 - Agency B Summary Is Empty
  type: http
  seq: 78
}

get {
  url: {{BASE_URL}}/api/agency/alerts/summary
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.counts.open: eq 0
  res.body.counts.acknowledged: eq 0
  res.body.counts.resolved: eq 0
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  // §113 — the evaluation ran for B (seeding B's own 11 rules) but found
  // nothing: Agency A's projects and invoices are invisible.
  if (raw.top.length !== 0) throw new Error('Agency B must have no top rows, got ' + raw.top.length);
}
