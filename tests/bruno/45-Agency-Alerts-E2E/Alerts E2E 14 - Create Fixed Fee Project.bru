meta {
  name: Alerts E2E 14 - Create Fixed Fee Project
  type: http
  seq: 14
}

post {
  url: {{BASE_URL}}/api/agency/projects
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "name": "Alert Brand Sprint",
    "code": "E2E-ALR-BRAND",
    "billingModel": "FIXED_FEE",
    "currency": "INR",
    "startDate": "{{alToday}}",
    "contractValue": 50000
  }
}

assert {
  res.status: eq 201
  res.body.project.billingModel: eq FIXED_FEE
  res.body.project.contractValue: eq 50000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('project2Id', raw.project.id);
  if (!raw.project.id) throw new Error('Create must return the project id');
}

docs {
  The §18 subject: a fixed-fee contract with nothing invoiced. Once
  COMPLETED, its §67 unbilled amount is the whole contract remainder
  (max(0, contractValue − billed) = 50000) → exactly one CRITICAL.
}
