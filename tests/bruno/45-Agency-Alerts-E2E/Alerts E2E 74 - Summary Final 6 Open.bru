meta {
  name: Alerts E2E 74 - Summary Final 6 Open
  type: http
  seq: 74
}

get {
  url: {{BASE_URL}}/api/agency/alerts/summary
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.counts.open: eq 6
  res.body.counts.acknowledged: eq 0
  res.body.counts.resolved: eq 3
  res.body.counts.openBySeverity.CRITICAL: eq 2
  res.body.counts.openBySeverity.WARNING: eq 2
  res.body.counts.openBySeverity.INFO: eq 2
}

docs {
  The steady state: 6 open (over-budget + completed CRITICAL; hours +
  due-soon WARNING; unbilled time + expense INFO), 3 resolved (invoice B's
  two, silenced margin). The days-10 overlay left the due-soon alert live —
  config PATCH takes effect without collateral.
}
