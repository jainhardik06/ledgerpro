meta {
  name: Alerts E2E 60 - Confirm Payment Invoice B Fully Paid
  type: http
  seq: 60
}

post {
  url: {{BASE_URL}}/api/agency/payments/{{paymentId}}/confirm
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.payment.status: eq CONFIRMED
  res.body.invoice.status: eq PAID
  res.body.invoice.amountDue.amount: eq 0
}

docs {
  The world changes (§20): a settled invoice leaves the Module 14 open A/R
  set, so its two cash conditions disappear. The next evaluation must
  auto-resolve both — with NO actor, because nobody dismissed them.
}
