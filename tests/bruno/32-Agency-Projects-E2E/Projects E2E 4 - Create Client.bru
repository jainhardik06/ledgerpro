meta {
  name: Projects E2E 4 - Create Client
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/agency/clients
  body: json
  auth: none
}

body:json {
  {
    "name": "Northwind Retail E2E",
    "email": "ap@northwind-e2e.test",
    "billingProfile": { "city": "Pune", "country": "India", "currency": "INR" },
    "commercialDefaults": { "billingModel": "FIXED_FEE", "paymentTerms": "NET_30", "currency": "INR" }
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.client.name: eq Northwind Retail E2E
  res.body.client.status: eq ACTIVE
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('clientId', raw.client.id);
  if (!raw.client.id) {
    throw new Error('Create must return the client id for the project step');
  }
}

docs {
  The client every project attaches to (§80 — same-tenant reference).
}
