meta {
  name: Projects E2E 1 - Signup
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "tenantName": "E2E Projects Agency",
    "username": "{{projectsUsername}}",
    "password": "{{projectsPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

script:pre-request {
  // Unique credentials per run so the suite is repeatable against a
  // persistent database.
  const suffix = Date.now().toString(36);
  bru.setVar('projectsUsername', 'e2e_projects_' + suffix);
  bru.setVar('projectsPassword', 'E2eProjects#2026');
}

docs {
  Module 3.9 E2E — a fresh agency tenant for the project lifecycle flow:
  Create Client → Create Project → Activate → Add Member → Create Work
  Item → Dashboard (§104).
}
