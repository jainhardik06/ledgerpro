meta {
  name: Team E2E 7 - Create Project
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/agency/projects
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "name": "Initech Studio Launch",
    "billingModel": "FIXED_FEE",
    "currency": "INR",
    "contractValue": 500000,
    "projectManagerId": "{{userId}}"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.project.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('projectId', raw.project.id);
  if (!raw.project.id) {
    throw new Error('Create must return the project id for the team steps');
  }
}

docs {
  The project is created WITH a project manager (the admin) but WITHOUT
  members — deliberately, so the §39 auto-add is observable when this
  project activates later in the suite.
}
