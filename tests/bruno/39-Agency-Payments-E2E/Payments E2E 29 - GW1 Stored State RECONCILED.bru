meta {
  name: Payments E2E 29 - GW1 Stored State RECONCILED
  type: http
  seq: 29
}

get {
  url: {{BASE_URL}}/api/agency/payments/{{payGW1Id}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.payment.status: eq CONFIRMED
  res.body.payment.reconciliationStatus: eq RECONCILED
  res.body.payment.gatewayPaymentId: eq {{gw1External}}
  res.body.invoice.status: eq PARTIALLY_PAID
  res.body.invoice.amountPaid.amount: eq 40000
  res.body.invoice.amountDue.amount: eq 60000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  if (!raw.payment.transactionId) throw new Error('§129: the webhook-confirmed payment must link its transaction');
}

docs {
  §115 — the gateway payment is RECONCILED the moment its verified money
  landed in the ledger; the invoice settled 40000 of 100000 — from the
  STORED payment's amount, not the payload's lie.
}
