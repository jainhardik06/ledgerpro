meta {
  name: Payments E2E 25 - Reverse Payment B1 Compensating Debit
  type: http
  seq: 25
}

post {
  url: {{BASE_URL}}/api/agency/payments/{{payB1Id}}/reverse
  body: json
  auth: none
}

body:json {
  {
    "reason": "chargeback — funds returned"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.payment.status: eq REVERSED
  res.body.invoice.status: eq SENT
  res.body.invoice.amountPaid.amount: eq 0
  res.body.invoice.amountDue.amount: eq 100000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const txId = raw.transactionId;
  if (!txId) throw new Error('§103: the reversal must create a compensating Debit');
  bru.setVar('txnBReverseId', txId);
}

docs {
  §103/§104 — the payment STAYS in history as REVERSED; a compensating
  Debit returns the 40000 cash; the invoice walks back PARTIALLY_PAID →
  SENT with the full 100000 due again (settled 0, never negative).
}
