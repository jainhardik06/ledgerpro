meta {
  name: Payments E2E 6 - Create Invoice A Draft
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "issueDate": "{{issueDate}}",
    "notes": "September retainer — the §156 gate invoice"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
  res.body.invoice.total.amount: eq 0
}

script:pre-request {
  const ist = new Date(Date.now() + 5.5 * 60 * 60 * 1000);
  bru.setVar('issueDate', ist.toISOString().slice(0, 10));
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('invAId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
  if (raw.invoice.invoiceNumber != null) throw new Error('§74: draft must not carry a number');
}
