meta {
  name: Payments E2E 12 - Record Manual Payment 60000
  type: http
  seq: 12
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{invAId}}",
    "amount": 60000,
    "method": "UPI",
    "accountId": "{{accountId}}",
    "reference": "UPI-SETTLED-6K"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
  res.body.payment.amount.amount: eq 60000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('payA2Id', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
}
