meta {
  name: Payments E2E 9 - Record Manual Payment 40000
  type: http
  seq: 9
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{invAId}}",
    "amount": 40000,
    "method": "BANK_TRANSFER",
    "accountId": "{{accountId}}",
    "reference": "NEFT-4400"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
  res.body.payment.amount.amount: eq 40000
  res.body.payment.method: eq BANK_TRANSFER
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('payA1Id', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
  if (raw.payment.gateway !== undefined) throw new Error('A manual payment carries no gateway identity');
}

docs {
  §90 — the PARTIAL payment: 40000 of 100000, landing PENDING (§101 —
  nothing moves until confirmation).
}
