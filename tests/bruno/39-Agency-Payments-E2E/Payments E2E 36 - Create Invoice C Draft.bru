meta {
  name: Payments E2E 36 - Create Invoice C Draft
  type: http
  seq: 36
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "issueDate": "{{issueDate}}",
    "notes": "Invoice C — reconciliation error and recovery journey"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('invCId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}
