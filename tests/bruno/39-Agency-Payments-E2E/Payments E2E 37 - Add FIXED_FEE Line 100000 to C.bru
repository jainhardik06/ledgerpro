meta {
  name: Payments E2E 37 - Add FIXED_FEE Line 100000 to C
  type: http
  seq: 37
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invCId}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "FIXED_FEE",
    "description": "November engagement — reconciliation",
    "quantity": 1,
    "unitPrice": 100000,
    "amount": 0
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.total.amount: eq 100000
}
