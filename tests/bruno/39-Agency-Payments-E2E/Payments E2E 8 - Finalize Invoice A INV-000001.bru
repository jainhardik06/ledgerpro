meta {
  name: Payments E2E 8 - Finalize Invoice A INV-000001
  type: http
  seq: 8
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invAId}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000001
  res.body.invoice.total.amount: eq 100000
  res.body.invoice.amountPaid.amount: eq 0
  res.body.invoice.amountDue.amount: eq 100000
}

docs {
  §83/§74 — INV-000001, the first invoice of a fresh tenant: 100000 INR
  outstanding, nothing settled. The §156 gate starts here.
}
