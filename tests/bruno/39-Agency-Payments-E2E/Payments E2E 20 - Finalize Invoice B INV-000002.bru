meta {
  name: Payments E2E 20 - Finalize Invoice B INV-000002
  type: http
  seq: 20
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invBId}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000002
  res.body.invoice.amountDue.amount: eq 100000
}
