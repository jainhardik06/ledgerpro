meta {
  name: Payments E2E 32 - Record Gateway Payment 60000 on B
  type: http
  seq: 32
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

script:pre-request {
  // Same run-unique suffix as E2E 26 — §96 duplicate detection is global
  // and the local store persists across runs.
  const suffix = bru.getVar('gwSuffix') || Date.now().toString(36);
  bru.setVar('gwSuffix', suffix);
  bru.setVar('gw2External', 'pay_e2e_gw_2_' + suffix);
}

body:json {
  {
    "invoiceId": "{{invBId}}",
    "amount": 60000,
    "method": "RAZORPAY",
    "gatewayPaymentId": "{{gw2External}}",
    "accountId": "{{accountId}}"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
  res.body.payment.reconciliationStatus: eq PENDING
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('payGW2Id', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
}
