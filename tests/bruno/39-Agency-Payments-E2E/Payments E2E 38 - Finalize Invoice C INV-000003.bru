meta {
  name: Payments E2E 38 - Finalize Invoice C INV-000003
  type: http
  seq: 38
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invCId}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000003
  res.body.invoice.amountDue.amount: eq 100000
}
