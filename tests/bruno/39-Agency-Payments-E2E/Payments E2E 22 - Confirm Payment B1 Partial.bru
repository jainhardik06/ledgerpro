meta {
  name: Payments E2E 22 - Confirm Payment B1 Partial
  type: http
  seq: 22
}

post {
  url: {{BASE_URL}}/api/agency/payments/{{payB1Id}}/confirm
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.payment.status: eq CONFIRMED
  res.body.invoice.status: eq PARTIALLY_PAID
  res.body.invoice.amountDue.amount: eq 60000
}
