meta {
  name: Payments E2E 7 - Add FIXED_FEE Line 100000
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invAId}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "FIXED_FEE",
    "description": "September engagement — full month",
    "quantity": 1,
    "unitPrice": 100000,
    "amount": 0
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.line.amount.amount: eq 100000
  res.body.invoice.subtotal.amount: eq 100000
  res.body.invoice.total.amount: eq 100000
}
