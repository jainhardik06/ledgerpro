meta {
  name: Payments E2E 23 - Record Manual Payment 70000 on B
  type: http
  seq: 23
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{invBId}}",
    "amount": 70000,
    "method": "UPI",
    "accountId": "{{accountId}}"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('payB2Id', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
}

docs {
  §101 — a second PENDING payment may legally coexist (PENDING money is
  not settled); the overpay refusal happens at CONFIRMATION (§91).
}
