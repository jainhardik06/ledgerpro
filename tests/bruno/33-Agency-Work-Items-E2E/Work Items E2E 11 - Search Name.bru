meta {
  name: Work Items E2E 11 - Search Name
  type: http
  seq: 11
}

get {
  url: {{BASE_URL}}/api/agency/projects/{{projectId}}/work-items?search=hero
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const found = raw.workItems || [];
  if (found.length !== 1 || found[0].name !== 'Homepage hero illustration') {
    throw new Error('search must match the work item name, got ' + found.length);
  }
}

docs {
  §24 — search covers the work item NAME.
}
