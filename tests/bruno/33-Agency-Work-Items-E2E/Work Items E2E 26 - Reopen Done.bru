meta {
  name: Work Items E2E 26 - Reopen Done
  type: http
  seq: 26
}

patch {
  url: {{BASE_URL}}/api/agency/projects/{{projectId}}/work-items/{{secondWorkItemId}}?action=status
  body: json
  auth: none
}

body:json {
  {
    "status": "IN_PROGRESS"
  }
}

assert {
  res.status: eq 200
  res.body.workItem.status: eq IN_PROGRESS
}

docs {
  §11 — "client changes may require reopening completed work": DONE →
  IN_PROGRESS is the one allowed backward transition.
}
