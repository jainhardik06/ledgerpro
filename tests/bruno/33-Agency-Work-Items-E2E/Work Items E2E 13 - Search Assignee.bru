meta {
  name: Work Items E2E 13 - Search Assignee
  type: http
  seq: 13
}

get {
  url: {{BASE_URL}}/api/agency/projects/{{projectId}}/work-items?search={{workUsername}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const found = raw.workItems || [];
  if (found.length !== 1 || found[0].id !== bru.getVar('workItemId')) {
    throw new Error('search must match the assignee username, got ' + found.length);
  }
}

docs {
  §24 — search covers the ASSIGNEE: the query resolves tenant usernames to
  ids server-side and matches the assigned work item.
}
