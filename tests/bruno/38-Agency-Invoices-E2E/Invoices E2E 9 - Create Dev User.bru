meta {
  name: Invoices E2E 9 - Create Dev User
  type: http
  seq: 9
}

post {
  url: {{BASE_URL}}/api/tenant/users
  body: json
  auth: none
}

body:json {
  {
    "username": "{{invDevUsername}}",
    "password": "E2eInvDev#2026"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.user.role: eq USER
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar('invDevUsername', 'e2e_inv_dev_' + suffix);
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('devUserId', raw.user.id);
  if (!raw.user.id) throw new Error('Create must return the user id');
}

docs {
  The work AUTHOR (time + expenses) and later the §28 probe: a plain USER
  must be able to READ the invoice list but never compose one.
}
