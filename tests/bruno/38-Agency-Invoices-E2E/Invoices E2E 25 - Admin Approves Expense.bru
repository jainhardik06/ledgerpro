meta {
  name: Invoices E2E 25 - Admin Approves Expense
  type: http
  seq: 25
}

post {
  url: {{BASE_URL}}/api/agency/expenses/{{expenseId}}/approve
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.expense.status: eq APPROVED
  res.body.expense.billingStatus: eq UNBILLED
  res.body.expense.clientChargeAmount.amount: eq 12000
}
