meta {
  name: Invoices E2E 57 - Send Invoice A stamps sentAt
  type: http
  seq: 57
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invAId}}/send
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000001
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  if (!raw.invoice.sentAt) {
    throw new Error('Expected sentAt to be stamped by the send action (§81)');
  }
}

docs {
  §81/§82 — finalization ISSUED the invoice (SENT + INV-000001); send
  records the DELIVERY act: a sentAt stamp + an INVOICE_SENT audit event.
  Status and money are untouched by the send.
}
