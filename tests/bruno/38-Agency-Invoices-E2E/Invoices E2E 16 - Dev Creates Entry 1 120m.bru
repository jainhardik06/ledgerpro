meta {
  name: Invoices E2E 16 - Dev Creates Entry 1 120m
  type: http
  seq: 16
}

post {
  url: {{BASE_URL}}/api/agency/time
  body: json
  auth: none
}

body:json {
  {
    "projectId": "{{projectId}}",
    "date": "{{entryDate}}",
    "durationMinutes": 120,
    "billable": true,
    "notes": "Portal API scaffolding"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.timeEntry.approvalStatus: eq DRAFT
  res.body.timeEntry.billingStatus: eq UNBILLED
  res.body.timeEntry.financialStatus: eq READY
  res.body.timeEntry.billingRateSnapshot.amount: eq 2500
}

script:pre-request {
  const ist = new Date(Date.now() + 5.5 * 60 * 60 * 1000);
  bru.setVar('entryDate', ist.toISOString().slice(0, 10));
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('entry1Id', raw.timeEntry.id);
  if (!raw.timeEntry.id) throw new Error('Create must return the entry id');
}

docs {
  Entry 1 is the INVOICED hour-pair: 2h × 2500 = 5000 on the invoice, with
  2h × 900 = 1800 internal cost (§23).
}
