}

assert {
  res.status: eq 409
}

docs {
  §79/§81 — a VOID invoice is retired and can never be sent. (The DRAFT
  leg — "finalize before sending", §74 — is pinned by the unit suite;
  no live draft remains in this journey by this point.)
}
