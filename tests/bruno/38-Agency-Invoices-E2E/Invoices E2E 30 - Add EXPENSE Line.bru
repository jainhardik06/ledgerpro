meta {
  name: Invoices E2E 30 - Add EXPENSE Line
  type: http
  seq: 30
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invAId}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "EXPENSE",
    "sourceId": "{{expenseId}}",
    "description": "StockAI API credits (20% margin)"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.line.type: eq EXPENSE
  res.body.invoice.subtotal.amount: eq 17000
}

docs {
  §43/§77 — the expense line carries the frozen clientChargeAmount 12000
  (5000 + 12000 = 17000 subtotal).
}
