meta {
  name: Invoices E2E 20 - Dev Creates Billable Expense 10000 20pct
  type: http
  seq: 20
}

post {
  url: {{BASE_URL}}/api/agency/expenses
  body: json
  auth: none
}

body:json {
  {
    "projectId": "{{projectId}}",
    "vendorName": "StockAI",
    "description": "API credits for the portal build",
    "amount": 10000,
    "expenseType": "BILLABLE",
    "billable": true,
    "markupPercent": 20,
    "expenseDate": "{{entryDate}}"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.expense.status: eq DRAFT
  res.body.expense.billingStatus: eq UNBILLED
  res.body.expense.clientChargeAmount.amount: eq 12000
  res.body.expense.clientChargeAmount.currency: eq INR
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const e = raw.expense;
  bru.setVar('expenseId', e.id);
  if (!e.id) throw new Error('Create must return the expense id');
  // §43 — 10000 + 20% = 12000, frozen at creation.
  if (e.clientChargeAmount.amount !== 12000) throw new Error('markup: expected client charge 12000');
  // §99 — the dev is a USER: the cost side is redacted.
  if (e.amount !== undefined) throw new Error('§99 redaction violated: amount leaked to a USER');
  if (e.markupPercent !== undefined) throw new Error('§99 redaction violated: markupPercent leaked to a USER');
}
