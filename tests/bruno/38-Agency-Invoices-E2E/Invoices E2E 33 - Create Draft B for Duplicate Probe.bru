meta {
  name: Invoices E2E 33 - Create Draft B for Duplicate Probe
  type: http
  seq: 33
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "projectId": "{{projectId}}",
    "issueDate": "{{issueDate}}"
  }
}

assert {
  res.status: eq 201
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('invBId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}

docs {
  A SECOND admin composing a draft for the same work — the concurrency
  stand-in for two people invoicing simultaneously (§65).
}
