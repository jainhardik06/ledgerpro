meta {
  name: Invoices E2E 22 - Login Back as Admin
  type: http
  seq: 22
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{invAdminUsername}}",
    "password": "{{invAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
