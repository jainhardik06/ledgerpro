meta {
  name: Reports E2E 6 - Create Billing Card
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/api/agency/rate-cards
  body: json
  auth: none
}

body:json {
  {
    "name": "Repsoft Billing E2E",
    "type": "BILLING",
    "scope": "CLIENT",
    "clientId": "{{clientId}}",
    "currency": "INR"
  }
}

assert {
  res.status: eq 201
  res.body.card.type: eq BILLING
  res.body.card.scope: eq CLIENT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('billingCardId', raw.card.id);
  if (!raw.card.id) throw new Error('Create must return the card id');
}
