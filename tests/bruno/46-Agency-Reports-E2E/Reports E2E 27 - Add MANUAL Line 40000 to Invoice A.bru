meta {
  name: Reports E2E 27 - Add MANUAL Line 40000 to Invoice A
  type: http
  seq: 27
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invAId}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "MANUAL",
    "description": "Sprint 1 milestone",
    "amount": 40000
  }
}

assert {
  res.status: eq 201
  res.body.line.type: eq MANUAL
  res.body.invoice.subtotal.amount: eq 40000
}
