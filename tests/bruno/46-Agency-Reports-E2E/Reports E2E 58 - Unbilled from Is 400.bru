meta {
  name: Reports E2E 58 - Unbilled from Is 400
  type: http
  seq: 58
}

get {
  url: {{BASE_URL}}/api/agency/reports/unbilled?from=2026-01-01
  body: none
  auth: none
}

assert {
  res.status: eq 400
}

docs {
  Unbilled is a POSITION (what is unbilled right now), not a flow — a
  date window is meaningless and therefore a 400.
}
