meta {
  name: Reports E2E 33 - Record Payment 50000 on Invoice B
  type: http
  seq: 33
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{invBId}}",
    "amount": 50000,
    "method": "BANK_TRANSFER",
    "accountId": "{{accountId}}",
    "reference": "NEFT-REP-50K"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
  res.body.payment.amount.amount: eq 50000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('paymentId', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
}
