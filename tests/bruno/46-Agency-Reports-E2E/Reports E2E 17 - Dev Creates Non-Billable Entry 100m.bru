meta {
  name: Reports E2E 17 - Dev Creates Non-Billable Entry 100m
  type: http
  seq: 17
}

post {
  url: {{BASE_URL}}/api/agency/time
  body: json
  auth: none
}

body:json {
  {
    "projectId": "{{projectId}}",
    "date": "{{repToday}}",
    "durationMinutes": 100,
    "billable": false,
    "notes": "Internal sprint planning"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.timeEntry.approvalStatus: eq DRAFT
  res.body.timeEntry.billable: eq false
  res.body.timeEntry.costRateSnapshot.amount: eq 900
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('entry2Id', raw.timeEntry.id);
  if (!raw.timeEntry.id) throw new Error('Create must return the entry id');
}

docs {
  Entry 2 — the COST-only minutes: 100m × 900/hr = 1500 internal cost,
  zero client value. The §32 utilization denominator must feel it.
}
