meta {
  name: Reports E2E 29 - Draft Invoice B Due Minus 10
  type: http
  seq: 29
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "issueDate": "{{repDueMinus10}}",
    "dueDate": "{{repDueMinus10}}",
    "notes": "Overdue anchor — 150k, 10 days past due"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('invBId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}

docs {
  Past issueDate is VALID (only the future is rejected) — aging derives
  from the real due date (§88/§89): ~10 days overdue → bucket 1-30.
}
