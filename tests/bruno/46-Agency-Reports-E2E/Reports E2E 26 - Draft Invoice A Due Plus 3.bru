meta {
  name: Reports E2E 26 - Draft Invoice A Due Plus 3
  type: http
  seq: 26
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "issueDate": "{{repToday}}",
    "dueDate": "{{repDuePlus3}}",
    "notes": "Due-soon anchor — inside the default 7-day window"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
  res.body.invoice.total.amount: eq 0
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('invAId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}

docs {
  The §35 due-soon row: standalone (no project) so the receivables report
  shows a null-project column handled honestly.
}
