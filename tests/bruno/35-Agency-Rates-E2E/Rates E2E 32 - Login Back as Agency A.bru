meta {
  name: Rates E2E 32 - Login Back as Agency A
  type: http
  seq: 32
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{ratesUsername}}",
    "password": "{{ratesPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  Switch the cookie jar back to A's admin for the reverse isolation probe.
}
