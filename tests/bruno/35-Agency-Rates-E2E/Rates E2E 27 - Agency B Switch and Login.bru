meta {
  name: Rates E2E 27 - Agency B Switch and Login
  type: http
  seq: 27
}

post {
  url: {{BASE_URL}}/api/settings
  body: json
  auth: none
}

body:json {
  {
    "appMode": "Agency"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  B flips to Agency mode, then logs in. (Login would be a separate step but
  signup already set B's session cookie; the settings call proves the
  session carries B's tenant.)
}
