meta {
  name: Expenses E2E 21 - Admin Approves Main Expense
  type: http
  seq: 21
}

post {
  url: {{BASE_URL}}/api/agency/expenses/{{expMainId}}/approve
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.expense.status: eq APPROVED
  res.body.expense.billingStatus: eq UNBILLED
  res.body.expense.clientChargeAmount.amount: eq 12000
  res.body.expense.amount.amount: eq 10000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const e = raw.expense;
  if (!e.transactionId) throw new Error('APPROVED expense must carry a transactionId (§41)');
  bru.setVar('txMainId', e.transactionId);
}

docs {
  The §41 moment for the main expense: the core Transaction is created
  (a 10000 Debit, category Expense) and linked. txMainId is captured —
  the §42 idempotency assert later depends on it.
}
