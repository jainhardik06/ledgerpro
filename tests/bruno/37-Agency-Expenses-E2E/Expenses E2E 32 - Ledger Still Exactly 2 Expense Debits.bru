meta {
  name: Expenses E2E 32 - Ledger Still Exactly 2 Expense Debits
  type: http
  seq: 32
}

get {
  url: {{BASE_URL}}/api/transactions?limit=100
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const expenseDebits = raw.transactions.filter(t => t.category === 'Expense' && t.type === 'Debit');
  if (expenseDebits.length !== 2) throw new Error('§42 violated: expected exactly 2 expense Debits after re-approval, got ' + expenseDebits.length);
  const sum = expenseDebits.reduce((s, t) => s + Number(t.amount), 0);
  if (sum !== 12000) throw new Error('expense debits must total 12000, got ' + sum);
}
