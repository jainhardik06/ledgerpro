meta {
  name: Expenses E2E 1 - Signup
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "tenantName": "E2E Expenses Agency",
    "username": "{{expAdminUsername}}",
    "password": "{{expAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar('expAdminUsername', 'e2e_exp_admin_' + suffix);
  bru.setVar('expAdminPassword', 'E2eExpAdmin#2026');
}

docs {
  Fresh agency for the Module 8 journey: expenses → markup → approval →
  ledger linkage → invoice eligibility → tenant isolation, with a second
  user so §21 (never your own expense) and the PM approval tier are both
  exercised end-to-end.
}
