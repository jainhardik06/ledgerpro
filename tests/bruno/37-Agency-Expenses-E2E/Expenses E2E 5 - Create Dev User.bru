meta {
  name: Expenses E2E 5 - Create Dev User
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api/tenant/users
  body: json
  auth: none
}

body:json {
  {
    "username": "{{expDevUsername}}",
    "password": "E2eExpDev#2026"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.user.role: eq USER
}

script:pre-request {
  const suffix = Date.now().toString(36);
  bru.setVar('expDevUsername', 'e2e_exp_dev_' + suffix);
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('devUserId', raw.user.id);
  if (!raw.user.id) throw new Error('Create must return the user id');
}

docs {
  The expense AUTHOR (a plain USER). The dev is also the project MANAGER,
  so both approver tiers exist: PM approves the admin's expense, admin
  approves the dev's (§21 forbids anyone approving their own).
}
