meta {
  name: Expenses E2E 19 - Login Back as Admin
  type: http
  seq: 19
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{expAdminUsername}}",
    "password": "{{expAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
