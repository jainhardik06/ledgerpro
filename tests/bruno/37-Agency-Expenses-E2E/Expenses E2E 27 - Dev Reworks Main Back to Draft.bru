meta {
  name: Expenses E2E 27 - Dev Reworks Main Back to Draft
  type: http
  seq: 27
}

patch {
  url: {{BASE_URL}}/api/agency/expenses/{{expMainId}}
  body: json
  auth: none
}

body:json {
  {
    "vendorName": "StockAI India",
    "amount": 10000,
    "currency": "INR"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.expense.status: eq DRAFT
  res.body.expense.clientChargeAmount.amount: eq 12000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const e = raw.expense;
  // §20 pattern — editing a REJECTED expense returns it to DRAFT.
  if (e.status !== 'DRAFT') throw new Error('rework must reset REJECTED to DRAFT, got ' + e.status);
  // Economics edit recomputes the charge that rejection withdrew (§43).
  if (e.clientChargeAmount == null || e.clientChargeAmount.amount !== 12000) {
    throw new Error('economics edit must recompute clientChargeAmount to 12000');
  }
  // §99 — dev is still a USER.
  if (e.amount !== undefined) throw new Error('§99 redaction violated on PATCH response');
}

docs {
  The rework loop: an economics edit (amount + currency) on the rejected
  expense both resets it to DRAFT and recomputes the withdrawn client
  charge from the stored inputs — 10000 + 20% = 12000 again.
}
