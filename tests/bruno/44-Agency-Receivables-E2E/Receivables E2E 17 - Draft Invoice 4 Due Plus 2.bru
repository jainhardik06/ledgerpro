meta {
  name: Receivables E2E 17 - Draft Invoice 4 Due Plus 2
  type: http
  seq: 17
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientIdB}}",
    "issueDate": "{{rcvToday}}",
    "dueDate": "{{duePlus2}}",
    "notes": "Current invoice — inside the due-soon window"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('inv4Id', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}
