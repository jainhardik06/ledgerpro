meta {
  name: Receivables E2E 10 - Finalize INV-000001
  type: http
  seq: 10
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{inv1Id}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000001
  res.body.invoice.total.amount: eq 30000
  res.body.invoice.amountDue.amount: eq 30000
}
