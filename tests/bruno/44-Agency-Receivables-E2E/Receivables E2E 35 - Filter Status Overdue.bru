meta {
  name: Receivables E2E 35 - Filter Status Overdue
  type: http
  seq: 35
}

get {
  url: {{BASE_URL}}/api/agency/receivables?status=OVERDUE
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const r = raw.receivables;
  // §80/§91 — the filter matches the DERIVED display status: three invoices
  // STORED as SENT display OVERDUE and are all caught.
  if (r.openInvoiceCount !== 3) throw new Error('OVERDUE filter must catch 3 invoices, got ' + r.openInvoiceCount);
  if (r.outstanding !== 90000) throw new Error('OVERDUE outstanding must be 90000, got ' + r.outstanding);
  if (!r.invoices.every(i => i.displayStatus === 'OVERDUE')) throw new Error('every row must display OVERDUE');
  if (!r.invoices.every(i => i.status === 'SENT')) throw new Error('every row is stored SENT (the §80 derivation)');
  if (r.dueSoon !== 0) throw new Error('nothing in the overdue set is due soon');
}
