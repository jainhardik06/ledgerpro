meta {
  name: Receivables E2E 13 - Finalize INV-000002
  type: http
  seq: 13
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{inv2Id}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000002
  res.body.invoice.total.amount: eq 40000
}
