meta {
  name: Receivables E2E 11 - Draft Invoice 2 Due Minus 45
  type: http
  seq: 11
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientIdA}}",
    "projectId": "{{projectId}}",
    "issueDate": "{{dueMinus45}}",
    "dueDate": "{{dueMinus45}}",
    "notes": "Sprint billing — the 31-60 bucket anchor"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('inv2Id', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}
