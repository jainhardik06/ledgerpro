meta {
  name: Receivables E2E 16 - Finalize INV-000003
  type: http
  seq: 16
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{inv3Id}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000003
  res.body.invoice.total.amount: eq 20000
}
