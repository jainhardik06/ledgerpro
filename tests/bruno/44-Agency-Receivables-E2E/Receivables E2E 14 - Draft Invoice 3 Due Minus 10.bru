meta {
  name: Receivables E2E 14 - Draft Invoice 3 Due Minus 10
  type: http
  seq: 14
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientIdA}}",
    "issueDate": "{{dueMinus10}}",
    "dueDate": "{{dueMinus10}}",
    "notes": "Standalone advisory — the 1-30 bucket anchor, no project"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('inv3Id', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
  if (raw.invoice.projectId != null) throw new Error('This invoice must be standalone (null project)');
}
