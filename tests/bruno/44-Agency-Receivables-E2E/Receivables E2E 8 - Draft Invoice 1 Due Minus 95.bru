meta {
  name: Receivables E2E 8 - Draft Invoice 1 Due Minus 95
  type: http
  seq: 8
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientIdA}}",
    "projectId": "{{projectId}}",
    "issueDate": "{{dueMinus95}}",
    "dueDate": "{{dueMinus95}}",
    "notes": "Retainer recovery — the 90+ bucket anchor"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
  res.body.invoice.total.amount: eq 0
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('inv1Id', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
  if (raw.invoice.invoiceNumber != null) throw new Error('§74: draft must not carry a number');
}

docs {
  Past issueDate is VALID (only the future is rejected) — that is what makes
  the overdue scenario honest E2E: the invoice is finalized for a real past
  billing event, and aging derives from the due date (§88/§89).
}
