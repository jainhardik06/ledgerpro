meta {
  name: Receivables E2E 25 - Draft Invoice 6 Due Minus 3
  type: http
  seq: 25
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientIdA}}",
    "issueDate": "{{dueMinus3}}",
    "dueDate": "{{dueMinus3}}",
    "notes": "The §93 withholding subject — settles in full, must VANISH from A/R"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('inv6Id', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}
