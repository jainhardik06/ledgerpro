meta {
  name: Receivables E2E 22 - Finalize INV-000005
  type: http
  seq: 22
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{inv5Id}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000005
  res.body.invoice.total.amount: eq 100000
  res.body.invoice.amountDue.amount: eq 100000
}
