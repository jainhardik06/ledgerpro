meta {
  name: Receivables E2E 23 - Record Payment 70000 on INV-000005
  type: http
  seq: 23
}

post {
  url: {{BASE_URL}}/api/agency/payments
  body: json
  auth: none
}

body:json {
  {
    "invoiceId": "{{inv5Id}}",
    "amount": 70000,
    "method": "BANK_TRANSFER",
    "accountId": "{{accountId}}",
    "reference": "NEFT-RCV-70K"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.payment.status: eq PENDING
  res.body.payment.amount.amount: eq 70000
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('payPartialId', raw.payment.id);
  if (!raw.payment.id) throw new Error('Record must return the payment id');
}
