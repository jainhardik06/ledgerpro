meta {
  name: Receivables E2E 21 - Add MANUAL Line 100000 to Invoice 5
  type: http
  seq: 21
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{inv5Id}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "MANUAL",
    "description": "Annual platform licence + implementation",
    "amount": 100000
  }
}

assert {
  res.status: eq 201
  res.body.line.type: eq MANUAL
  res.body.invoice.subtotal.amount: eq 100000
}
