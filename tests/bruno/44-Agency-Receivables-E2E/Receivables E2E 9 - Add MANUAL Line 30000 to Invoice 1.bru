meta {
  name: Receivables E2E 9 - Add MANUAL Line 30000 to Invoice 1
  type: http
  seq: 9
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{inv1Id}}/lines
  body: json
  auth: none
}

body:json {
  {
    "type": "MANUAL",
    "description": "Recovery retainer — Q1 arrears",
    "amount": 30000
  }
}

assert {
  res.status: eq 201
  res.body.line.type: eq MANUAL
  res.body.invoice.subtotal.amount: eq 30000
}
