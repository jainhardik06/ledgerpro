meta {
  name: Tax E2E 23 - Create Invoice Draft C
  type: http
  seq: 23
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientIdMH}}",
    "issueDate": "{{issueDate}}",
    "notes": "September consulting — the intra-state CGST+SGST journey"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
  res.body.invoice.total.amount: eq 0
}

script:pre-request {
  const ist = new Date(Date.now() + 5.5 * 60 * 60 * 1000);
  bru.setVar('issueDate', ist.toISOString().slice(0, 10));
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('invCId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
}

docs {
  The intra-state journey (§10/§30): a third draft, this time on the
  Maharashtra client — supplier and recipient share a state.
}
