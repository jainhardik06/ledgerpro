meta {
  name: Tax E2E 10 - Create Invoice Draft A
  type: http
  seq: 10
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{clientId}}",
    "issueDate": "{{issueDate}}",
    "notes": "September consulting — the Module 11 compliance journey"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
  res.body.invoice.total.amount: eq 0
}

script:pre-request {
  const ist = new Date(Date.now() + 5.5 * 60 * 60 * 1000);
  const issueDate = ist.toISOString().slice(0, 10);
  bru.setVar('issueDate', issueDate);
  // §23 — the CBIC fiscal year of the issue date (April–March), computed the
  // same way types/dates.ts fiscalYear() does, for the finalization asserts.
  const y = +issueDate.slice(0, 4);
  const m = +issueDate.slice(5, 7);
  const start = m >= 4 ? y : y - 1;
  bru.setVar('expectedFy', 'FY' + start + '-' + String((start + 1) % 100).padStart(2, '0'));
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('invAId', raw.invoice.id);
  if (!raw.invoice.id) throw new Error('Create must return the invoice id');
  if (raw.invoice.invoiceNumber != null) throw new Error('§74: draft must not carry a number');
}
