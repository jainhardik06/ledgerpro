meta {
  name: Tax E2E 14 - Finalize INV-000001 with Snapshot and E-Invoice PENDING
  type: http
  seq: 14
}

post {
  url: {{BASE_URL}}/api/agency/invoices/{{invAId}}/finalize
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.invoice.status: eq SENT
  res.body.invoice.invoiceNumber: eq INV-000001
  res.body.invoice.total.amount: eq 118000
  res.body.invoice.eInvoice.status: eq PENDING
  res.body.invoice.complianceSnapshot.supplier.legalName: eq Atlas Digital Private Limited
  res.body.invoice.complianceSnapshot.recipient.name: eq Bengaluru Systems LLP
  res.body.invoice.complianceSnapshot.recipient.state: eq Karnataka
  res.body.invoice.complianceSnapshot.placeOfSupply.stateOrRegion: eq Karnataka
  res.body.invoice.complianceSnapshot.taxLines[0].type: eq IGST
  res.body.invoice.complianceSnapshot.classifications[0].classification.code: eq "998314"
  res.body.invoice.complianceSnapshot.taxRulesUsed[0]: eq gst-rules-2026.1
  res.body.invoice.complianceSnapshot.numbering.invoiceNumber: eq INV-000001
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const inv = raw.invoice;
  // §23 — the invoice is numbered in its FISCAL YEAR (April–March).
  const expectedFy = bru.getVar('expectedFy');
  if (inv.fiscalYear !== expectedFy) {
    throw new Error('§23: expected fiscalYear ' + expectedFy + ', got ' + inv.fiscalYear);
  }
  if (inv.complianceSnapshot.numbering.fiscalYear !== expectedFy) {
    throw new Error('§25: snapshot numbering must freeze the same fiscal year');
  }
  if (!inv.complianceSnapshot.capturedAt) {
    throw new Error('§25: the snapshot must carry its capture timestamp');
  }
}

docs {
  §23–§27 — THE Module 11 finalization: INV-000001 (first of the fresh
  tenant's fiscal year), the compliance snapshot frozen ONCE (supplier,
  recipient, place of supply, IGST line, SAC classification, rules version,
  numbering), and e-invoice PENDING — GST lines + both parties' GSTINs —
  with NO IRP call, ever (§27).
}
