meta {
  name: Settings E2E 40 - User GET Settings 200
  type: http
  seq: 40
}

get {
  url: {{BASE_URL}}/api/agency/settings
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.settings.general.defaultCurrency: eq USD
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const text = JSON.stringify(raw);
  if (text.includes('e2e_secret_value')) throw new Error('USER saw key secret plaintext');
  if (text.includes('whsec_e2e_tenant_1')) throw new Error('USER saw webhook secret plaintext');
  if (text.includes('v1:')) throw new Error('ciphertext leaked to USER');
}

docs {
  §55 — USER can READ settings (their own workspace view, the admin's
  writes included) but never any secret plaintext.
}
