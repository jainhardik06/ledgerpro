meta {
  name: Settings E2E 59 - Agency B Stores Own Webhook Secret
  type: http
  seq: 59
}

patch {
  url: {{BASE_URL}}/api/agency/settings/payment
  body: json
  auth: none
}

body:json {
  {
    "razorpayEnabled": true,
    "webhookSecret": "whsec_e2e_tenant_b"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.settings.payment.razorpayEnabled: eq true
  res.body.settings.payment.hasWebhookSecret: eq true
}

docs {
  The attack's key step — a plain TENANT_ADMIN stores its OWN webhook
  secret (a legal §50 action). Before the §51 tenant binding this made the
  secret a PLATFORM-WIDE signing key; the binding (requests 60–62) is what
  scopes it to B's own entities.
}
