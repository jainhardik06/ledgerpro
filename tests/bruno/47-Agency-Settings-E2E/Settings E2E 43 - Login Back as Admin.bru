meta {
  name: Settings E2E 43 - Login Back as Admin
  type: http
  seq: 43
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{stAdminUsername}}",
    "password": "{{stAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  Back to Agency A's admin for the isolation probes.
}
