meta {
  name: Settings E2E 25 - Create User
  type: http
  seq: 25
}

post {
  url: {{BASE_URL}}/api/tenant/users
  body: json
  auth: none
}

body:json {
  {
    "username": "{{stUserUsername}}",
    "password": "E2eSetUser#2026"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.user.role: eq USER
}

script:pre-request {
  bru.setVar('stUserUsername', 'e2e_set_user_' + bru.getVar('stRunToken'));
}

docs {
  The §55 permission-matrix probe: a plain USER of the same workspace.
}
