meta {
  name: Settings E2E 48 - Login Back as Agency A Admin Final
  type: http
  seq: 48
}

post {
  url: {{BASE_URL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{stAdminUsername}}",
    "password": "{{stAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  Back to Agency A's admin (the cookie jar holds Agency B's session after
  request 47) for the §44 engine-consumption probes: the agency
  defaultCurrency and invoicePrefix rungs.
}
