meta {
  name: Settings E2E 27 - PATCH Payment Save Secrets
  type: http
  seq: 27
}

patch {
  url: {{BASE_URL}}/api/agency/settings/payment
  body: json
  auth: none
}

body:json {
  {
    "razorpayEnabled": true,
    "razorpayKeyId": "rzp_test_e2e",
    "razorpayKeySecret": "e2e_secret_value_1",
    "webhookSecret": "whsec_e2e_tenant_1"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.settings.payment.razorpayEnabled: eq true
  res.body.settings.payment.razorpayKeyId: eq rzp_test_e2e
  res.body.settings.payment.hasKeySecret: eq true
  res.body.settings.payment.hasWebhookSecret: eq true
}

script:post-response {
  const text = typeof res.body === 'string' ? res.body : JSON.stringify(res.body);
  // §48/§49/§50 — the plaintext NEVER appears in any response, not even to
  // the admin who just submitted it; nor does the ciphertext.
  if (text.includes('e2e_secret_value_1')) throw new Error('key secret plaintext leaked');
  if (text.includes('whsec_e2e_tenant_1')) throw new Error('webhook secret plaintext leaked');
  if (text.includes('v1:')) throw new Error('ciphertext leaked');
  if (text.includes('Encrypted')) throw new Error('encrypted field name leaked');
}

docs {
  §49/§50 lifecycle — ADD: the secrets are AES-256-GCM encrypted at rest
  (AGENCY_MASTER_KEY) and the response carries only the has* booleans. The
  tenant webhook secret value is reused for the §51 multi-secret webhook
  probe later.
}
