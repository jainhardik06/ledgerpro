meta {
  name: Settings E2E 29 - Rotate Key Secret
  type: http
  seq: 29
}

patch {
  url: {{BASE_URL}}/api/agency/settings/payment
  body: json
  auth: none
}

body:json {
  {
    "razorpayKeySecret": "e2e_secret_value_2"
  }
}

assert {
  res.status: eq 200
  res.body.settings.payment.hasKeySecret: eq true
}

script:post-response {
  const text = typeof res.body === 'string' ? res.body : JSON.stringify(res.body);
  if (text.includes('e2e_secret_value_2')) throw new Error('rotated plaintext leaked');
  if (text.includes('e2e_secret_value_1')) throw new Error('old plaintext leaked');
}

docs {
  §50 — ROTATE: a new secret simply overwrites the stored ciphertext; the
  other fields (key id, webhook secret) are untouched by the merge-patch.
}
