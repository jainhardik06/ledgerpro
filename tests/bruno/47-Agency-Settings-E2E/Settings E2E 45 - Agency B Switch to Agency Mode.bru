meta {
  name: Settings E2E 45 - Agency B Switch to Agency Mode
  type: http
  seq: 45
}

post {
  url: {{BASE_URL}}/api/settings
  body: json
  auth: none
}

body:json {
  {
    "appMode": "Agency"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  Settings live under the Agency app mode for B as well.
}
