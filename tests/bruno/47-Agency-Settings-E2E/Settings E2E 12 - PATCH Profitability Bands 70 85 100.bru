meta {
  name: Settings E2E 12 - PATCH Profitability Bands 70 85 100
  type: http
  seq: 12
}

patch {
  url: {{BASE_URL}}/api/agency/settings/profitability
  body: json
  auth: none
}

body:json {
  {
    "targetProjectMargin": 35,
    "hourWarningThresholds": { "first": 70, "warning": 85, "critical": 100 },
    "overdueWarningDays": 14
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.settings.profitability.targetProjectMargin: eq 35
  res.body.settings.profitability.hourWarningThresholds.first: eq 70
  res.body.settings.profitability.hourWarningThresholds.warning: eq 85
  res.body.settings.profitability.hourWarningThresholds.critical: eq 100
  res.body.settings.profitability.overdueWarningDays: eq 14
}

docs {
  §46 — configuration ONLY: the thresholds write through to the Module 15
  rules (asserted next); no formula lives in settings.
}
