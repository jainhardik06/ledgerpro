meta {
  name: Settings E2E 36 - Disable Razorpay
  type: http
  seq: 36
}

patch {
  url: {{BASE_URL}}/api/agency/settings/payment
  body: json
  auth: none
}

body:json {
  {
    "razorpayEnabled": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.settings.payment.razorpayEnabled: eq false
  res.body.settings.payment.hasKeySecret: eq true
  res.body.settings.payment.hasWebhookSecret: eq true
}

docs {
  §50 — DISABLE: the switch flips off but the stored secrets are KEPT so a
  later re-enable works without re-entering them (the has* booleans stay
  true).
}
