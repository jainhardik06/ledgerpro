meta {
  name: Settings E2E 49 - Create Client Without Currency
  type: http
  seq: 49
}

post {
  url: {{BASE_URL}}/api/agency/clients
  body: json
  auth: none
}

body:json {
  {
    "name": "Settings Currency Default Co",
    "email": "cc-{{stRunToken}}@settings-e2e.test"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  bru.setVar('stCcClientId', raw.client.id);
  if (!raw.client.id) throw new Error('Create must return the client id');
}

docs {
  §44 prerequisite — a client with NO billingProfile.currency, so the
  invoice currency ladder falls past the client rung to the AGENCY
  general.defaultCurrency rung (request 5 set USD).
}
