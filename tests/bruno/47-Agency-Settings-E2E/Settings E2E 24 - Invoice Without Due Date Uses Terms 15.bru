meta {
  name: Settings E2E 24 - Invoice Without Due Date Uses Terms 15
  type: http
  seq: 24
}

post {
  url: {{BASE_URL}}/api/agency/invoices
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{stClientId}}",
    "issueDate": "{{stToday}}"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.invoice.status: eq DRAFT
}

script:post-response {
  const raw = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;
  const inv = raw.invoice;
  // §45 — the agency billing.paymentTermsDays (15) rung of the fallback
  // ladder: dueDate = issueDate + 15 calendar days.
  const expected = new Date(Date.UTC(+inv.issueDate.slice(0, 4), +inv.issueDate.slice(5, 7) - 1, +inv.issueDate.slice(8, 10), 12) + 15 * 86400000);
  const expectedDue = expected.toISOString().slice(0, 10);
  if (inv.dueDate !== expectedDue) {
    throw new Error('dueDate: expected ' + expectedDue + ' (agency terms 15), got ' + inv.dueDate);
  }
}

docs {
  §45 engine consumption — the due-date fallback ladder: no explicit
  dueDate, no client commercialDefaults.paymentTerms (the client above has
  none) ⇒ the AGENCY billing.paymentTermsDays (15) rung applies:
  dueDate = issueDate + 15 days. Written by the invoice engine, never by
  the settings document.
}
