meta {
  name: Settings E2E 38 - Re-Enable Without Re-Entering Secrets
  type: http
  seq: 38
}

patch {
  url: {{BASE_URL}}/api/agency/settings/payment
  body: json
  auth: none
}

body:json {
  {
    "razorpayEnabled": true
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.settings.payment.razorpayEnabled: eq true
  res.body.settings.payment.hasKeySecret: eq true
  res.body.settings.payment.hasWebhookSecret: eq true
  res.body.settings.payment.razorpayKeyId: eq rzp_test_e2e
}

docs {
  §50 — the point of keeping secrets through a disable: a bare re-enable
  restores the full configuration with NOTHING re-submitted (keyId returns,
  has* booleans stay true).
}
