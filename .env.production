# Money OS — production environment template.
#
# This file lists every env var the app needs in production. It intentionally
# holds NO real secrets — Next.js only auto-loads `.env.production` for values
# that are safe to ship in the build (there are none of those here), and
# Vercel does not read this file for deployments at all. Set the real values
# directly in Vercel: Project → Settings → Environment Variables → Production.
#
# This file exists so the full list of required vars is version-controlled
# and reviewable, without ever committing a secret.

# ── Database (MongoDB Atlas) ──
# Production SaaS data. Separate cluster/db from the Growth DB below.
MONGODB_URI=

# Growth DB — isolated cluster used by the Discovery Intelligence Center and
# the money-os-discovery site's /go affiliate redirects. Same value in both
# repos' production env.
MONGODB_GROWTH_URI=

# ── Auth ──
# 32+ byte random hex string. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── App URL ──
# Production domain, no protocol needed (code adds https:// if missing).
NEXT_PUBLIC_APP_URL=moneyos.webasthetic.in

# ── Super Admin ──
SUPER_ADMIN_USERNAME=
# bcrypt hash of the admin password, NOT the plaintext password.
SUPER_ADMIN_PASSWORD_HASH=

# ── Analytics: Google Analytics 4 ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Analytics: PostHog ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ── Growth Intelligence: Google APIs (GA4 Data API + Search Console) ──
# Full service-account JSON as a ONE-LINE string (Vercel has no persistent
# filesystem, so GOOGLE_APPLICATION_CREDENTIALS — a file path — will not
# work there; the code reads this JSON var instead, see src/lib/external-apis.ts).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GA4_PROPERTY_ID=
