# ==============================================================================
# Money OS — environment template (.env.example)
#
# Copy to .env.local (development) or configure in your deployment environment
# (production). NEVER commit a populated env file — .gitignore blocks .env*.
#
# Fail-closed rules (the app REFUSES to start in production without these):
#   MONGODB_URI, MONGODB_GROWTH_URI, JWT_SECRET, SUPER_ADMIN_PASSWORD_HASH
# ===============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — Database (MongoDB)
# The app throws [FATAL] at startup in production when these are missing; the
# local JSON fallback (.data/local_db.json) is a development/CI convenience only.
# ------------------------------------------------------------------------------
# Primary application database (tenants, users, transactions, agency data).
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/moneyos?retryWrites=true&w=majority
# Growth/discovery database (directories, social profiles, submissions).
# Separate cluster or database is fine — it must not share the primary's load.
MONGODB_GROWTH_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/moneyos-growth?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# REQUIRED — Authentication
# ------------------------------------------------------------------------------
# Session JWT signing secret. Generate: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# Super-admin login. Generate the bcrypt hash of a STRONG password, e.g.:
#   node -e "require('bcryptjs').hash('YOUR_PASSWORD', 12).then(h => console.log(h))"
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD_HASH=$2a$12$...your-bcrypt-hash...

# ------------------------------------------------------------------------------
# REQUIRED — Public site URL (sitemap, canonical links, analytics callbacks)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# Agency vertical — payment gateway (Razorpay)
# ------------------------------------------------------------------------------
# Deployment-level webhook secret from your Razorpay dashboard (Webhooks page).
# Tenants may additionally store their OWN webhook secret in Agency Settings
# (encrypted with AGENCY_MASTER_KEY) — both verify, tenant secrets are bound
# to the tenant's own entities.
RAZORPAY_WEBHOOK_SECRET=
# Deployment-level API credentials (used to create payment links when a tenant
# has not stored its own credentials in Agency Settings). Leave empty to run
# without hosted payment links — the gateway fails closed (503), never fake.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# Agency vertical — credential encryption (AES-256-GCM master key)
# Encrypts tenant-stored Razorpay secrets at rest. Base64, exactly 32 bytes:
#   openssl rand -base64 32
# WARNING: losing this key makes stored tenant secrets undecryptable; rotating
# it invalidates them (tenants re-enter). Generate ONCE and back it up safely.
# Keep DIFFERENT values per environment (dev data must not decrypt with the
# production key). Without this key the app still boots — secret STORAGE is
# simply refused with a 503 (fail closed), and the env webhook secret is used.
# ------------------------------------------------------------------------------
# Agency Vertical — Cloud Storage for Agency Logos & Profile Pictures
# Toggle between "supabase" and "s3" (AWS S3, Cloudflare R2, MinIO, Wasabi)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=supabase

# --- Option A: Supabase Storage ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agency-assets

# --- Option B: S3-Compatible Object Storage (AWS S3, Cloudflare R2, MinIO) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=agency-assets
S3_REGION=us-east-1
# S3_ENDPOINT is required for Cloudflare R2 / MinIO (e.g. https://<account_id>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# S3_PUBLIC_DOMAIN provides custom CDN or public domain (e.g. https://pub-xxxx.r2.dev or https://cdn.yourdomain.com)
S3_PUBLIC_DOMAIN=
# Set to true for MinIO or path-style S3 compatible providers
S3_FORCE_PATH_STYLE=false


# ------------------------------------------------------------------------------
# OPTIONAL — Analytics & measurement (features degrade gracefully when unset)
# ------------------------------------------------------------------------------
# Client-side measurement IDs (public by design).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Growth Intelligence Center (server-side, super-admin dashboards).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Google service account for GA4 + Search Console APIs (server-side). Provide
# EITHER the JSON inline (recommended for most hosts) OR a file path.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GA4_PROPERTY_ID=
